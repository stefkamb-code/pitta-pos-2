<Window x:Class="PittaPos.App.Views.TableDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
        Title="ΤΡΑΠΕΖΙ" Height="720" Width="480"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding TitleLabel}" FontWeight="ExtraBold" FontSize="16"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Border/>
            </DockPanel>
        </Border>

        <!-- rounds / lines -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,16">
                <TextBlock Text="Δεν έχει παραγγελθεί τίποτα ακόμα" FontSize="13" Foreground="{DynamicResource Neutral500}"
                           HorizontalAlignment="Center" Margin="0,24"
                           Visibility="{Binding NoRounds, Converter={StaticResource BoolToVis}}"/>
                <!-- ΑΝΑ ΑΤΟΜΟ — μία ομάδα = μία απόδειξη στην ταμειακή. Φαίνεται μόνο σε τραπέζι που
                     πληρώνει χωριστά· αλλιώς η οθόνη μένει ακριβώς όπως ήταν, ανά γύρο. -->
                <StackPanel Margin="0,0,0,20" Visibility="{Binding HasPersons, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ReceiptsHeader}" FontSize="13" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Accent}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Persons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Κλικ πάνω στην κάρτα = διάλεξε ΟΛΟ το άτομο· ανάβει κόκκινο και η κάτω
                                     μπάρα δείχνει «Ν ΕΠΙΛΕΓΜΕΝΑ / ✓ ΠΛΗΡΩΜΕΝΟ». Ίδια χειρονομία με το
                                     κινητό — δεν υπάρχει πια ξεχωριστό κουμπί πληρωμής μέσα σε κάθε άτομο. -->
                                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,10" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.TogglePersonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Το Background μπαίνει ΕΔΩ και όχι ως attribute: τοπική τιμή θα
                                                 νικούσε τον trigger και η κάρτα δεν θα άναβε ποτέ. Δεν είναι
                                                 Transparent — χωρίς γέμισμα το κλικ περνάει από μέσα. -->
                                            <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OutstandingLabel}"
                                                       FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                            <!-- «Το ΑΤΟΜΟ Β θέλει και μια κόκα κόλα»: γράφεται στη ΔΙΚΗ του
                                                 απόδειξη, δεν ανοίγει νέο άτομο. -->
                                            <Button DockPanel.Dock="Right" Content="+ ΠΡΟΣΘΗΚΗ" Margin="0,0,10,0"
                                                    Style="{StaticResource FlatButton}" Padding="10,4" FontSize="10.5"
                                                    FontWeight="ExtraBold" VerticalAlignment="Center"
                                                    ToolTip="Πρόσθεσε κι άλλο σε αυτό το άτομο"
                                                    Visibility="{Binding CanAddMore, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.AddToPersonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,0,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RevenueLabel}" FontSize="11.5"
                                                                   Foreground="{DynamicResource Neutral600}"/>
                                                        <TextBlock Text="{Binding QtyNameLabel}" FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Neutral600}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="✓ ΠΛΗΡΩΜΕΝΟ — η απόδειξη κόπηκε" FontSize="11.5" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Neutral500}" HorizontalAlignment="Center"
                                                   Visibility="{Binding IsPaid, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Rounds}"
                              Visibility="{Binding ShowRounds, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TableRoundViewModel}">
                            <StackPanel Margin="0,0,0,18">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="✕" FontSize="9" Width="20" Height="20" Padding="0"
                                            Style="{StaticResource GlyphButton}"
                                            ToolTip="Ακύρωση γύρου (διαγραφή)" Click="CancelRound_Click"/>
                                    <TextBlock Text="{Binding TimeLabel}" FontSize="11.5"
                                               FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"/>
                                </DockPanel>
                                <Border Background="{DynamicResource Accent100}" Padding="10,7" Margin="0,0,0,8"
                                        Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Note}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Accent700}"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TableLineViewModel}">
                                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Padding="14,10"
                                                        Command="{Binding DataContext.SelectLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RevenueLabel}" FontSize="13.5"
                                                                       FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Neutral500}"/>
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding QtyNameLabel}" FontSize="13.5">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Neutral500}"/>
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Details}" FontSize="10.5" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Neutral500}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="✓ πληρώθηκε ξεχωριστά" FontSize="10.5" FontWeight="ExtraBold"
                                                                   Foreground="{DynamicResource Accent700}" Margin="0,2,0,0"
                                                                   Visibility="{Binding IsSettled, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- footer: είτε μπάρα ενεργειών πολλαπλής επιλογής, είτε οι κανονικές ενέργειες τραπεζιού -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,2,0,0" Padding="18,16">
            <Grid>
                <!-- Ν προϊόντα επιλεγμένα -->
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTotalLabel}" FontSize="22"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="{Binding SelectedCountLabel}" FontSize="15" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Ink}" VerticalAlignment="Bottom"/>
                    </DockPanel>
                    <Button Content="{Binding SettleSelectedLabel}" Style="{StaticResource PrimaryButton}"
                            Height="46" FontSize="13.5" HorizontalContentAlignment="Center"
                            Margin="0,0,0,10" Command="{Binding RequestSettleSelectedCommand}"/>
                    <Button Content="✕ ΑΚΥΡΩΣΗ (ΔΙΑΓΡΑΦΗ)" Style="{StaticResource FlatButton}"
                            Height="42" FontSize="12.5" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                            Foreground="{DynamicResource Accent700}" BorderBrush="{DynamicResource Accent}"
                            Margin="0,0,0,10" Click="CancelSelected_Click"/>
                </StackPanel>

                <!-- κανονικές ενέργειες τραπεζιού -->
                <StackPanel Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding OutstandingTotalLabel}" FontSize="22"
                                   FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="ΟΦΕΙΛΟΜΕΝΟ" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"
                                   VerticalAlignment="Bottom"/>
                    </DockPanel>
                    <Button Content="{Binding NewRoundLabel}" Style="{StaticResource PrimaryButton}"
                            Height="46" FontSize="14" HorizontalContentAlignment="Center"
                            Margin="0,0,0,10" Command="{Binding RequestNewRoundCommand}"/>
                    <!-- Κλείσιμο τραπεζιού: ό,τι έχει μείνει ανεξόφλητο θεωρείται ότι πληρώθηκε τώρα —
                         ο τρόπος ρωτιέται στο επόμενο βήμα. -->
                    <Button Content="✕ ΠΛΗΡΩΜΗ ΥΠΟΛΟΙΠΟΥ ΚΑΙ ΚΛΕΙΣΙΜΟ" Style="{StaticResource FlatButton}"
                            Height="42" FontSize="12.5" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                            Command="{Binding RequestCloseTableCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- «Πώς πληρώθηκε;» — παραθυράκι στη ΜΕΣΗ, πάνω από όλη την οθόνη. Το είχα βάλει στην κάτω
             μπάρα και ο ταμίας έπρεπε να κατεβάσει το μάτι του στη γωνία· εδώ πέφτει ακριβώς εκεί που
             κοιτάει μόλις πατήσει «ΠΛΗΡΩΜΗ». Το σκούρο φόντο πιάνει και τα κλικ, ώστε να μην πατηθεί
             κατά λάθος κάτι από κάτω όσο περιμένει απάντηση. -->
        <Border Grid.RowSpan="3" Background="#99000000"
                Visibility="{Binding IsChoosingPayment, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="22,20" Width="330"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding PendingPaymentTitle}" FontSize="14" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PendingPaymentAmountLabel}" FontSize="30" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button Content="💶 ΜΕΤΡΗΤΑ" Style="{StaticResource PrimaryButton}"
                                Height="52" FontSize="13.5" HorizontalContentAlignment="Center"
                                Margin="0,0,5,0" Command="{Binding PayCashCommand}"/>
                        <Button Content="💳 ΚΑΡΤΑ" Style="{StaticResource PrimaryButton}"
                                Height="52" FontSize="13.5" HorizontalContentAlignment="Center"
                                Margin="5,0,0,0" Command="{Binding PayCardCommand}"/>
                    </UniformGrid>
                    <Button Content="ΑΚΥΡΟ" Style="{StaticResource FlatButton}"
                            Height="38" FontSize="12" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                            Command="{Binding CancelPaymentCommand}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
