<Window x:Class="PittaPos.App.Views.ManageExtrasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PittaPos.App.Controls"
        xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
        xmlns:ac="clr-namespace:PittaPos.App.Controls"
        Title="ΚΟΙΝΑ ΕΞΤΡΑ" Height="640" Width="480"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <!-- Ολο το περιεχομενο μεγαλωνει/μικραινει μαζι με το παραθυρο, ΚΑΙ απλωνει στον χωρο που
         υπαρχει (βλ. Controls/ScaleHost) — γραμματα, κουμπια και αποστασεις στην ιδια αναλογια. -->
    <ctl:ScaleHost DesignWidth="464" DesignHeight="601">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <TextBlock DockPanel.Dock="Left" Text="ΚΟΙΝΑ ΕΞΤΡΑ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Border/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">
                <TextBlock Text="Ο κοινός κατάλογος έξτρα υλικών — διαθέσιμα σε όλα τα customizable προϊόντα, εκτός αν κάποιο τα περιορίζει (βλ. φόρμα προϊόντος)."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                <!-- double pita surcharge -->
                <TextBlock Text="ΔΙΠΛΗ ΠΙΤΑ — ΧΡΕΩΣΗ ΑΝΑ ΜΕΓΕΘΟΣ" FontSize="12" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Ink}" Margin="0,0,0,4"/>
                <TextBlock Text="Το μαγαζί έχει δύο πίτες. Η τιμή που βάζεις εδώ ισχύει σε ΟΛΕΣ τις κατηγορίες εκείνου του μεγέθους."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding DoublePitaRows}" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExtraCatalogRowViewModel}">
                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding NameText}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource PosTextBox}" Height="36"
                                             Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="4" Content="ΕΝΗΜΕΡΩΣΗ" Style="{StaticResource FlatButton}"
                                            Height="36" FontSize="10.5" FontWeight="ExtraBold" Padding="10,0"
                                            Command="{Binding DataContext.UpdateDoublePitaPriceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- add new -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Νέο έξτρα" FontSize="12" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                        <!-- Προτείνει ονόματα που έχεις ήδη γράψει ως βασικά υλικά κάπου αλλού — αυτά
                             ακριβώς που έχει νόημα να γίνουν και έξτρα. -->
                        <TextBox Style="{StaticResource PosTextBox}" Height="40"
                                 ac:AutoComplete.Suggestions="{Binding ExtraSuggestions}"
                                 Text="{Binding NewExtraName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Τιμή (κενό=δωρεάν)" FontSize="12" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource PosTextBox}" Height="40"
                                 Text="{Binding NewExtraPrice, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="+ ΠΡΟΣΘΗΚΗ" Style="{StaticResource PrimaryButton}"
                            Height="40" FontSize="12.5" FontWeight="ExtraBold" Padding="14,0"
                            VerticalAlignment="Bottom" Command="{Binding AddGlobalExtraCommand}"/>
                </Grid>

                <TextBlock Text="ΚΑΤΑΛΟΓΟΣ ΕΞΤΡΑ" FontSize="12" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Ink}" Margin="0,0,0,6"/>

                <ItemsControl ItemsSource="{Binding ExtraCatalogRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExtraCatalogRowViewModel}">
                            <!-- Ολόκληρη η γραμμή είναι στόχος για ρίξιμο: σέρνεις τη λαβή «⠿» και
                                 αφήνεις πάνω σε όποια γραμμή θες να πάει. Η σειρά εδώ είναι ΑΚΡΙΒΩΣ η
                                 σειρά που βλέπει ο ταμίας στα ΕΞΤΡΑ του customizer. -->
                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,10"
                                    Background="Transparent" AllowDrop="True" Drop="ExtraRow_Drop">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" Margin="0,0,6,0"
                                            Background="Transparent" Cursor="SizeAll" ToolTip="Σύρε για αλλαγή σειράς"
                                            MouseLeftButtonDown="ExtraDragHandle_MouseLeftButtonDown">
                                        <TextBlock Text="⠿" FontSize="15" Foreground="{DynamicResource Neutral400}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Το όνομα γράφεται κατευθείαν εδώ: μια ορθογραφική διόρθωση δεν
                                         πρέπει να απαιτεί διαγραφή + ξαναγράψιμο, που θα έσβηνε το έξτρα
                                         από όλα τα προϊόντα που το είχαν. -->
                                    <TextBox Grid.Column="1" Style="{StaticResource PosTextBox}" Height="36"
                                             FontSize="13.5" FontWeight="SemiBold"
                                             Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Style="{StaticResource PosTextBox}" Height="36"
                                             Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="5" Content="ΑΠΟΘΗΚΕΥΣΗ" Style="{StaticResource FlatButton}"
                                            Height="36" FontSize="10.5" FontWeight="ExtraBold" Padding="10,0"
                                            Command="{Binding DataContext.UpdateExtraPriceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="7" Content="×" Style="{StaticResource GlyphButton}" FontSize="16"
                                            Foreground="{DynamicResource Accent}" Width="30"
                                            Command="{Binding DataContext.DeleteGlobalExtraCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Accent}" Margin="0,14,0,0"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </ctl:ScaleHost>
</Window>
