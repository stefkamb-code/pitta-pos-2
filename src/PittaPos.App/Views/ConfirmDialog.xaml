<Window x:Class="PittaPos.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}"
        KeyDown="Window_KeyDown">
    <!-- Μία ερώτηση στη μέση, ΕΝΑ κουμπί ενέργειας. Άκυρο = κλείσιμο του παραθύρου ή Esc. -->
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="ExtraBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" TextAlignment="Center"/>

        <TextBlock x:Name="BodyText" FontSize="12.5" Foreground="{DynamicResource Neutral600}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,8,0,20"/>

        <Button x:Name="ActionButton" Click="Action_Click" Style="{StaticResource PrimaryButton}"
                Height="52" FontSize="15" HorizontalContentAlignment="Center"/>
    </StackPanel>
</Window>
