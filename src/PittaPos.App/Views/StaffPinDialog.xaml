<Window x:Class="PittaPos.App.Views.StaffPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ΠΟΙΟΣ ΑΚΥΡΩΝΕΙ" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}"
        KeyDown="Window_KeyDown">
    <StackPanel Margin="24">
        <TextBlock Text="Βάλε τον προσωπικό σου κωδικό ακύρωσης" FontSize="14" FontWeight="ExtraBold"
                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>

        <TextBlock x:Name="Dots" Text="" FontSize="30" FontWeight="ExtraBold" Height="44"
                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,14,0,2"/>

        <TextBlock x:Name="ErrorText" Text="Άγνωστος κωδικός" FontSize="12" FontWeight="ExtraBold"
                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                   Visibility="Hidden" Margin="0,0,0,10"/>

        <UniformGrid Columns="3">
            <Button Content="1" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="2" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="3" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="4" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="5" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="6" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="7" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="8" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="9" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="⌫" Click="Backspace_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="0" Click="Digit_Click" Style="{StaticResource FlatButton}" Height="58" FontSize="19" FontWeight="ExtraBold" HorizontalContentAlignment="Center" Margin="3"/>
            <Button Content="ΟΚ" Click="Ok_Click" Style="{StaticResource PrimaryButton}" Height="58" FontSize="16" HorizontalContentAlignment="Center" Margin="3"/>
        </UniformGrid>
    </StackPanel>
</Window>
