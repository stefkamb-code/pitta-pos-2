<UserControl x:Class="PittaPos.App.Views.TicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
             xmlns:conv="clr-namespace:PittaPos.App.Converters"
             FontFamily="{StaticResource PosFont}">
    <!-- Το δελτίο της παραγγελίας (στήλη δεξιά), με τα άτομα του τραπεζιού, τα σύνολα και το ΣΥΝΕΧΕΙΑ. ΚΟΙΝΟ για
         τις δύο οθόνες παραγγελίας (ProductsView για ποντίκι, ProductsTouchView για οθόνη αφής). Το DataContext
         είναι το ProductsViewModel της οθόνης που το φιλοξενεί. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:UpperCaseGreekConverter x:Key="UpperCase"/>

        <!-- Μπλοκ ενός ατόμου του τραπεζιού. Το ίδιο template χρησιμοποιείται ΔΥΟ φορές στη στήλη της
             παραγγελίας — για τα άτομα ΠΑΝΩ από αυτό που γράφεται και για τα ΑΠΟ ΚΑΤΩ — ώστε το άτομο
             να μένει στη θέση του (Α, Β, Γ, Δ με τη σειρά) όταν το επιλέγεις, αντί να «κατεβαίνει». -->
        <DataTemplate x:Key="PersonBlockTemplate">
            <!-- Πατιέται: ανοίγει η παραγγελία του ατόμου στο καλάθι, ζωντανή και επεξεργάσιμη —
                 για όταν κάποιος αλλάξει γνώμη. -->
            <StackPanel Margin="0,0,0,10" Background="Transparent" Cursor="Hand"
                        ToolTip="Πάτησέ το για να ανοίξεις ξανά την παραγγελία αυτού του ατόμου">
                <StackPanel.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectSentPersonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                </StackPanel.InputBindings>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" FontSize="11.5"
                               FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"
                               Visibility="{Binding ShowTotal, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Header}" FontSize="11.5" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Neutral600}"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Lines}" Margin="10,3,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PriceLabel}" FontSize="11"
                                           Foreground="{DynamicResource Neutral500}"/>
                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Neutral500}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Divider}" BorderThickness="2,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="16,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CartCountLabel}" FontSize="11"
                               Foreground="{DynamicResource Neutral600}" VerticalAlignment="Bottom"/>
                    <Button DockPanel.Dock="Right" Content="🔁" FontSize="15" Width="30" Height="30" Padding="0"
                            Style="{StaticResource GlyphButton}" Margin="0,0,10,0" ToolTip="Μία από τα ίδια"
                            Command="{Binding RepeatLastOrderCommand}"
                            Visibility="{Binding HasRepeatableOrder, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ΠΑΡΑΓΓΕΛΙΑ #" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        <!-- Για ΕΦΑΡΜΟΓΕΣ με δηλωμένο αριθμό πλατφόρμας, δείχνει αυτόν αντί για τον
                             εσωτερικό μας μετρητή — βλ. OrderWizardViewModel.DisplayOrderNumber. -->
                        <TextBlock Text="{Binding DataContext.DisplayOrderNumber, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0">
                <StackPanel>
                    <!-- Ποιανού γράφεται τώρα η παραγγελία. Φαίνεται μόνο σε τραπέζι που πληρώνει
                         χωριστά (ένα άτομο = μία απόδειξη στην ταμειακή) — αλλιώς δεν υπάρχει καν. -->
                    <!-- Τα άλλα άτομα του τραπεζιού, με τα προϊόντα τους — ξεθωριασμένα γιατί δεν
                         είναι αυτό που γράφεται τώρα. Ο ταμίας βλέπει ΟΛΟ το τραπέζι όσο γράφει,
                         ώστε να μη ρωτήσει δεύτερη φορά τον ίδιο άνθρωπο. Τίποτα δεν έχει
                         καταχωρηθεί ακόμα: πατώντας ένα μπλοκ, ανοίγει ξανά ζωντανό στο καλάθι. -->
                    <ItemsControl ItemsSource="{Binding DataContext.SentPersonsAbove, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ItemTemplate="{StaticResource PersonBlockTemplate}" Margin="0,10,0,0"/>

                    <!-- Ποιανού γράφεται τώρα η παραγγελία. Φαίνεται μόνο σε τραπέζι που πληρώνει
                         χωριστά (ένα άτομο = μία απόδειξη στην ταμειακή) — αλλιώς δεν υπάρχει καν. -->
                    <Border Background="{DynamicResource Accent100}" Padding="10,6" Margin="0,4,0,0"
                            Visibility="{Binding DataContext.IsSplittingTable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DataContext.PersonProgressLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource Accent700}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Άδεια παραγγελία" FontSize="12.5" Foreground="{DynamicResource Neutral500}"
                               HorizontalAlignment="Center" Margin="0,24"
                               Visibility="{Binding CartEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Cart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CartLineViewModel}">
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                                    Background="{DynamicResource Bg}" Height="24" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Ίδιο με το πάνω πλαίσιο ποσότητας: ρητά χρώματα, αλλιώς ο
                                                         αριθμός βγαίνει μαύρος και χάνεται στο μαύρο θέμα. -->
                                                    <Button Content="−" Width="20" Style="{StaticResource GlyphButton}" FontSize="13"
                                                            Foreground="{DynamicResource Ink}"
                                                            Command="{Binding DataContext.DecLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1,0" Width="22">
                                                        <TextBlock Text="{Binding Quantity}" FontWeight="ExtraBold" FontSize="12"
                                                                   Foreground="{DynamicResource Ink}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Button Content="+" Width="20" Style="{StaticResource GlyphButton}" FontSize="13"
                                                            Foreground="{DynamicResource Ink}"
                                                            Command="{Binding DataContext.IncLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                            <Button DockPanel.Dock="Right" Content="×" FontSize="15" Style="{StaticResource GlyphButton}"
                                                    Foreground="{DynamicResource Neutral500}" ToolTip="Αφαίρεση είδους" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button DockPanel.Dock="Right" Content="✎" FontSize="12" Style="{StaticResource GlyphButton}"
                                                    Foreground="{DynamicResource Neutral500}" ToolTip="Επεξεργασία" VerticalAlignment="Top"
                                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.EditLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" FontSize="14" FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource Ink}" VerticalAlignment="Top" Margin="6,2,4,0"/>
                                            <TextBlock Text="{Binding Name, Converter={StaticResource UpperCase}}" FontSize="14" FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource Ink}" Margin="9,2,0,0" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <!-- ...Inline: τα σχόλια σε μία αράδα, μόνο για την οθόνη.
                                             Η εκτύπωση τραβάει τα κανονικά DescLine1/DescLine2
                                             και τα κρατάει κάθετα, ένα ανά γραμμή. -->
                                        <TextBlock Text="{Binding DescLine1Inline, Converter={StaticResource UpperCase}}" FontSize="11.5" Foreground="{DynamicResource Neutral600}"
                                                   Margin="29,5,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasDesc, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding DescLine2Inline, Converter={StaticResource UpperCase}}" FontSize="11.5" Foreground="{DynamicResource Accent700}"
                                                   Margin="29,1,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasMods, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Τα άτομα ΜΕΤΑ από αυτό που γράφεται (βλ. SentPersonsAbove από πάνω). -->
                    <ItemsControl ItemsSource="{Binding DataContext.SentPersonsBelow, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ItemTemplate="{StaticResource PersonBlockTemplate}" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- totals -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,2,0,0" Padding="16,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalLabel}" FontSize="13" Foreground="{DynamicResource Neutral700}"/>
                        <TextBlock Text="Υποσύνολο" FontSize="13" Foreground="{DynamicResource Neutral700}"/>
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,2,0,0" Padding="0,9,0,0" Margin="0,6,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" FontSize="23" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text="ΣΥΝΟΛΟ" FontSize="16" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Bottom"/>
                        </DockPanel>
                    </Border>

                    <!-- order note: σε ΚΑΘΕ είδος παραγγελίας (βλ. ShowOrderNoteButton) -->
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding DataContext.ShowOrderNoteButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <Button Content="💬 ΣΧΟΛΙΑ ΠΑΡΑΓΓΕΛΙΑΣ" Style="{StaticResource FlatButton}" Padding="12,8"
                                FontSize="12.5" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                                Command="{Binding ToggleNoteFieldCommand}"/>
                        <TextBox Style="{StaticResource PosTextBox}" Height="60" Margin="0,8,0,0"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8,6"
                                 Visibility="{Binding ShowNoteField, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding DataContext.CustomerNotes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- actions -->
            <StackPanel Grid.Row="3" Margin="16,0,16,16">
                <Button Style="{StaticResource PrimaryButton}" Padding="14,13" FontSize="14"
                        IsEnabled="{Binding ContinueEnabled}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Command="{Binding ContinueCommand}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ContinueLabel}"/>
                        <TextBlock DockPanel.Dock="Right" Text="→"/>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Content="← Πίσω" FontSize="12.5"
                        Margin="0,8,0,0" Padding="12,8" HorizontalAlignment="Stretch"
                        Command="{Binding BackCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
