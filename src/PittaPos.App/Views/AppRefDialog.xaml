<Window x:Class="PittaPos.App.Views.AppRefDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ΚΩΔΙΚΟΣ" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}"
        KeyDown="Window_KeyDown">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Text="ΚΩΔΙΚΟΣ ΠΑΡΑΓΓΕΛΙΑΣ" FontSize="15" FontWeight="ExtraBold"
                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/>

        <TextBlock x:Name="SubText" FontSize="12" Foreground="{DynamicResource Neutral600}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Margin="0,6,0,16"/>

        <DockPanel>
            <Button DockPanel.Dock="Right" Content="ΟΚ" Click="Ok_Click" Style="{StaticResource PrimaryButton}"
                    Height="52" Width="96" FontSize="15" HorizontalContentAlignment="Center" Margin="8,0,0,0"/>
            <TextBox x:Name="RefBox" Height="52" FontSize="20" FontWeight="ExtraBold"
                     TextAlignment="Center" MaxLength="16" VerticalContentAlignment="Center"
                     Style="{StaticResource PosTextBox}"
                     PreviewTextInput="RefBox_PreviewTextInput"/>
        </DockPanel>

        <!-- Παραλείπεται συνειδητά: αν ο ταμίας δεν τον ξέρει τώρα, δεν πρέπει να μπλοκάρεται η
             διόρθωση. Κλείνοντας χωρίς κωδικό, η παραγγελία απλώς κρατά τον αριθμό που είχε. -->
        <TextBlock Text="Άφησέ το κενό αν δεν τον ξέρεις" FontSize="11"
                   Foreground="{DynamicResource Neutral500}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
