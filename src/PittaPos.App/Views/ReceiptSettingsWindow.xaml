<Window x:Class="PittaPos.App.Views.ReceiptSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ΚΑΤΑΣΚΕΥΗ ΑΠΟΔΕΙΞΗΣ" Height="720" Width="900"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png"
                       Height="32" Margin="0,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="ΚΑΤΑΣΚΕΥΗ ΑΠΟΔΕΙΞΗΣ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Border/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- fields -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26" MaxWidth="460" HorizontalAlignment="Left">
                    <TextBlock Text="Τίτλος" FontSize="12" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ReceiptTitleBox" Style="{StaticResource PosTextBox}" Height="38" Margin="0,0,0,12"
                             TextChanged="Receipt_Changed"/>

                    <TextBlock Text="Στοιχεία καταστήματος (διεύθυνση, τηλέφωνο, ΑΦΜ)" FontSize="12"
                               Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ReceiptInfoBox" Style="{StaticResource PosTextBox}" Height="80" Margin="0,0,0,12"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8,6"
                             TextChanged="Receipt_Changed"/>

                    <!-- Το «Υποσέλιδο» έφυγε: στη θέση του τυπώνεται πλέον αυτόματα ο τύπος και ο
                         αριθμός της παραγγελίας (ΤΡΑΠΕΖΙ #6), οπότε δεν υπάρχει τίποτα να ρυθμιστεί. -->

                    <CheckBox x:Name="ShowDateTimeCheck" Content="Ημερομηνία και ώρα" FontSize="12.5"
                              Foreground="{DynamicResource Ink}" Margin="0,0,0,8"
                              Checked="Receipt_Changed" Unchecked="Receipt_Changed"/>
                    <CheckBox x:Name="ShowCustomerCheck" Content="Στοιχεία πελάτη / τραπεζιού" FontSize="12.5"
                              Foreground="{DynamicResource Ink}" Margin="0,0,0,8"
                              Checked="Receipt_Changed" Unchecked="Receipt_Changed"/>
                    <CheckBox x:Name="ShowDetailsCheck" Content="Λεπτομέρειες προϊόντων (ψωμί / έξτρα / χωρίς)" FontSize="12.5"
                              Foreground="{DynamicResource Ink}" Margin="0,0,0,18"
                              Checked="Receipt_Changed" Unchecked="Receipt_Changed"/>

                    <TextBlock Text="Μεγέθη γραμμάτων" FontSize="12" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                    <TextBlock Text="Κάθε ενότητα ξεχωριστά — π.χ. μεγάλωσε μόνο τον τίτλο χωρίς να αλλάξουν οι γραμμές παραγγελίας."
                               FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Τίτλος" FontSize="11.5" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Height="44">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Width="38" Style="{StaticResource GlyphButton}" FontSize="15" Click="DecTitleFontSize_Click"/>
                                    <TextBlock x:Name="TitleFontSizeText" Width="42" FontSize="13" FontWeight="ExtraBold"
                                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="+" Width="38" Style="{StaticResource GlyphButton}" FontSize="15" Foreground="{DynamicResource Accent}" Click="IncTitleFontSize_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Προϊόντα" FontSize="11.5" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Height="44">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Width="38" Style="{StaticResource GlyphButton}" FontSize="15" Click="DecItemsFontSize_Click"/>
                                    <TextBlock x:Name="ItemsFontSizeText" Width="42" FontSize="13" FontWeight="ExtraBold"
                                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="+" Width="38" Style="{StaticResource GlyphButton}" FontSize="15" Foreground="{DynamicResource Accent}" Click="IncItemsFontSize_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Σύνολο" FontSize="11.5" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Height="44">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Width="38" Style="{StaticResource GlyphButton}" FontSize="15" Click="DecTotalFontSize_Click"/>
                                    <TextBlock x:Name="TotalFontSizeText" Width="42" FontSize="13" FontWeight="ExtraBold"
                                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="+" Width="38" Style="{StaticResource GlyphButton}" FontSize="15" Foreground="{DynamicResource Accent}" Click="IncTotalFontSize_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Λοιπά (ημ/νία, τύπος, υποσέλιδο)" FontSize="11.5" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10" Height="44">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Width="38" Style="{StaticResource GlyphButton}" FontSize="15" Click="DecMetaFontSize_Click"/>
                                    <TextBlock x:Name="MetaFontSizeText" Width="42" FontSize="13" FontWeight="ExtraBold"
                                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="+" Width="38" Style="{StaticResource GlyphButton}" FontSize="15" Foreground="{DynamicResource Accent}" Click="IncMetaFontSize_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Button Content="ΑΠΟΘΗΚΕΥΣΗ" Height="48" FontSize="14" FontWeight="ExtraBold" Width="250"
                            HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                            HorizontalContentAlignment="Center" Click="SaveReceipt_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- live preview -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource Divider}" BorderThickness="2,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,26">
                        <TextBlock Text="ΠΡΟΕΠΙΣΚΟΠΗΣΗ" FontSize="11" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Neutral600}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <Border Width="300" HorizontalAlignment="Center" BorderBrush="{DynamicResource Divider}" BorderThickness="2"
                                Padding="20" Background="{DynamicResource Bg}">
                            <StackPanel>
                                <TextBlock x:Name="PvTitle" FontSize="16" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock x:Name="PvInfo" FontSize="11" Foreground="{DynamicResource Neutral600}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="PvOrderLabel" Text="ΠΑΡΑΓΓΕΛΙΑ #1044" FontSize="11" Foreground="{DynamicResource Neutral600}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock x:Name="PvDateTime" Text="22/07/2026 · 14:30" FontSize="11"
                                           Foreground="{DynamicResource Neutral600}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1" Padding="0,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock x:Name="PvTypeValue" DockPanel.Dock="Right" Text="ΔΙΑΝΟΜΗ" FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock x:Name="PvTypeLabel" Text="Τύπος" FontSize="12.5" Foreground="{DynamicResource Neutral700}"/>
                                        </DockPanel>
                                        <DockPanel x:Name="PvCustomer">
                                            <TextBlock x:Name="PvWhoValue" DockPanel.Dock="Right" Text="Μαρία Π." FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock x:Name="PvWhoLabel" Text="Πελάτης" FontSize="12.5" Foreground="{DynamicResource Neutral700}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="0,3">
                                    <DockPanel>
                                        <TextBlock x:Name="PvItemPrice" DockPanel.Dock="Right" Text="€7,20" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock x:Name="PvItemName" Text="1 × Πίττα κοτόπουλο" FontSize="13" Foreground="{DynamicResource Ink}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="PvDetails" Text="Αραβική · + Μπέικον" FontSize="10.5"
                                               Foreground="{DynamicResource Neutral500}"/>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                                    <DockPanel>
                                        <TextBlock x:Name="PvTotalAmount" DockPanel.Dock="Right" Text="€7,20" FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock x:Name="PvTotalLabel" Text="ΣΥΝΟΛΟ" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Bottom"/>
                                    </DockPanel>
                                </Border>
                                <!-- Δείγμα: στο χαρτί μπαίνει ο πραγματικός τύπος/αριθμός της παραγγελίας. -->
                                <TextBlock x:Name="PvFooter" Text="ΤΡΑΠΕΖΙ #6" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource Ink}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
