<Window x:Class="PittaPos.App.Views.EfoodMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PittaPos.App.Controls"
        xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
        Title="ΑΝΤΙΣΤΟΙΧΙΣΗ E-FOOD" Height="760" Width="1060"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Το ✓ δεξιά όταν η γραμμή είναι έτοιμη, στη θέση του «ΣΩΣΤΟ». -->
        <Style x:Key="StateTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsConfirm}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Ολο το περιεχομενο μεγαλωνει/μικραινει μαζι με το παραθυρο (βλ. Controls/ScaleHost). -->
    <ctl:ScaleHost DesignWidth="1044" DesignHeight="721">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png"
                       Height="32" Margin="0,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="ΑΝΤΙΣΤΟΙΧΙΣΗ E-FOOD" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="↻  ΚΑΤΑΛΟΓΟΣ E-FOOD" Style="{StaticResource FlatButton}"
                        Height="36" FontSize="11.5" FontWeight="ExtraBold" Padding="14,0" HorizontalAlignment="Right"
                        Command="{Binding RefreshCatalogCommand}"/>
                <Border/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,16,24,10">
            <TextBlock Text="Ποιο προϊόν του ταμείου είναι κάθε προϊόν του e-food. Δεν αλλάζει ούτε ο κατάλογος του e-food ούτε το μενού ή το χαρτί του ταμείου — μόνο το πώς μπαίνουν οι παραγγελίες e-food. Όσα είναι κίτρινα τυπώνονται με το όνομα του e-food μέχρι να πατηθεί «ΣΩΣΤΟ» ή να διαλεχτεί προϊόν."
                       FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="{Binding PendingLabel}" Command="{Binding ShowPendingCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPendingOnly}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Left" Content="{Binding AllLabel}" Command="{Binding ShowAllCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FilterChip}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPendingOnly}" Value="False">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource Neutral600}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
            </DockPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding EmptyText}" FontSize="13" FontWeight="SemiBold" Margin="24,20"
                   Foreground="{DynamicResource Neutral600}" TextWrapping="Wrap"/>

        <!-- Εικονική λίστα: μόνο οι γραμμές που φαίνονται έχουν dropdowns — ο κατάλογος έχει εκατοντάδες προϊόντα. -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}" Padding="24,0,24,20"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto"
                                  Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:EfoodMatchRowViewModel}">
                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Column="0" Grid.RowSpan="2" CornerRadius="3" Background="{Binding Stripe}"/>

                            <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EfoodName}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding EfoodInfo}" FontSize="11" Foreground="{DynamicResource Neutral500}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- ItemsSource ΠΡΙΝ από το SelectedItem: αλλιώς το dropdown δεν βρίσκει την επιλογή και τη μηδενίζει. -->
                            <ComboBox Grid.Column="4" Style="{StaticResource PosComboBox}" Height="38" FontSize="12.5"
                                      ItemsSource="{Binding Categories}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
                            <ComboBox Grid.Column="6" Style="{StaticResource PosComboBox}" Height="38" FontSize="12.5"
                                      ItemsSource="{Binding Products}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                      IsEnabled="{Binding HasCategory}"/>
                            <ComboBox Grid.Column="8" Style="{StaticResource PosComboBox}" Height="38" FontSize="12.5"
                                      ItemsSource="{Binding BreadChoices}"
                                      SelectedItem="{Binding SelectedBread, Mode=TwoWay}"
                                      Visibility="{Binding BreadVisible, Converter={StaticResource BoolToVis}}"/>

                            <StackPanel Grid.Column="4" Grid.ColumnSpan="5" Grid.Row="1" Orientation="Horizontal" Margin="2,6,0,0">
                                <TextBlock Text="{Binding Preview}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Neutral700}"/>
                                <TextBlock Text="{Binding PriceNote}" FontSize="11.5" Margin="14,0,0,0"
                                           Foreground="{DynamicResource Neutral500}"/>
                            </StackPanel>

                            <Button Grid.Column="10" Grid.RowSpan="2" Content="ΣΩΣΤΟ" Style="{StaticResource PrimaryButton}"
                                    Height="38" FontSize="12" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                    IsEnabled="{Binding CanConfirm}"
                                    Visibility="{Binding NeedsConfirm, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <TextBlock Grid.Column="10" Grid.RowSpan="2" Text="{Binding StateText}" Style="{StaticResource StateTextStyle}"
                                       FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
    </ctl:ScaleHost>
</Window>
