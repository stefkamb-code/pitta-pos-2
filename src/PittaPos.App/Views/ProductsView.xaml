<UserControl x:Class="PittaPos.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
             xmlns:conv="clr-namespace:PittaPos.App.Converters"
             xmlns:views="clr-namespace:PittaPos.App.Views"
             FontFamily="{StaticResource PosFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:UpperCaseGreekConverter x:Key="UpperCase"/>


        <!-- Κάρτα φαγητού.
             Πριν, η κάρτα είχε ΤΟ ΙΔΙΟ χρώμα με το φόντο της οθόνης και ξεχώριζε μόνο από ένα σκληρό
             γκρι περίγραμμα — γι' αυτό έμοιαζε παλιά, σαν πίνακας με πλαίσια. Τώρα είναι λευκή πάνω
             στο γκρι φόντο, χωρίς περίγραμμα, με απαλή σκιά που της δίνει βάθος. Το περίγραμμα
             κρατιέται διαφανές και ανάβει κόκκινο μόνο στο φαγητό που έχει ανοιχτά τα υλικά του. -->
        <!-- Δικό της template ώστε να ελέγχουμε το στρογγύλεμα: το κοινό ElevatedButtonTemplate είναι
             κλειδωμένο στα 10, εδώ θέλουμε πιο μαλακή γωνία που «διαβάζεται» σαν σύγχρονη κάρτα. -->
        <ControlTemplate x:Key="ProductCardTemplate" TargetType="Button">
            <Grid>
                <Border Background="{TemplateBinding Background}" CornerRadius="14"
                        Effect="{StaticResource SoftShadowSmall}"/>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ControlTemplate>

        <Style x:Key="ProductCard" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Template" Value="{StaticResource ProductCardTemplate}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <!-- Σφιχτά: η κάρτα δεν χρειάζεται να «αναπνέει» τόσο σε ταμείο που θέλει να βλέπει όσο
                 περισσότερα φαγητά γίνεται με μια ματιά. Το βάθος το δίνει η σκιά, όχι τα κενά. -->
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <!-- Πατημένη σειρά χωρίς υλικά (ποτά, σαλάτες, μίνι): ίδιο σημάδι με το IsOpen, ώστε
                     το ένα κλικ να φαίνεται παντού — γράφεται πρώτο ώστε το IsOpen να το υπερισχύει. -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Τέσσερις στήλες: κατηγορίες | λίστα φαγητών | υλικά | δελτίο.
             Η στήλη των υλικών κρατάει ΠΑΝΤΑ το πλάτος της, ακόμα και άδεια. Δοκιμάστηκε να μαζεύεται
             στο μηδέν όταν δεν υπάρχει επιλεγμένο φαγητό, αλλά τότε η λίστα φάρδαινε και στένευε σε
             κάθε άνοιγμα/κλείσιμο: τα ονόματα χοροπηδούσαν και ο ταμίας έχανε τη σειρά που κοίταζε. -->
        <!-- Οι τρεις τελευταίες στήλες είναι αναλογικές (34/43/34), όσο δηλαδή πιάνουν σε οθόνη 1280:
             όταν μεγαλώνει το παράθυρο μοιράζονται τον επιπλέον χώρο ΜΑΖΙ — φαγητά, υλικά ΚΑΙ δελτίο.
             Μόνο οι κατηγορίες μένουν σταθερές: είναι σύντομες λέξεις, δεν κερδίζουν τίποτα από
             παραπάνω πλάτος, και βοηθάει να βρίσκονται πάντα στο ίδιο σημείο.
             Τα MinWidth κρατούν την οθόνη λειτουργική αν κάποιος μικρύνει πολύ το παράθυρο. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="34*" MinWidth="300"/>
            <ColumnDefinition Width="43*" MinWidth="410"/>
            <ColumnDefinition Width="34*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Category rail ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,2,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryItemViewModel}">
                            <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch" Padding="14,9">
                                <Button.Style>
                                    <!-- Η ενεργή κατηγορία γίνεται γεμάτο κόκκινο «χαπάκι» με λευκά
                                         γράμματα, αντί για απαλό ροζ με γκρίζα. Είναι η πιο ξεκάθαρη
                                         ένδειξη «εδώ βρίσκεσαι» και δίνει στην οθόνη έναν σύγχρονο
                                         τόνο, ίδιο με τα κουμπιά δράσης. -->
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="8,2,8,2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Name}" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Neutral700}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ================= Κάθετη λίστα φαγητών της κατηγορίας =================
             ΔΕΝ κρύβεται ποτέ. Παλιά ο customizer άνοιγε ακριβώς εδώ, στη θέση της λίστας, οπότε σε
             κάθε πίττα χανόταν από τα μάτια του ταμία ο κατάλογος και χρειαζόταν «πίσω» για την
             επόμενη. Τώρα τα υλικά ανοίγουν στη διπλανή στήλη και η λίστα μένει στη θέση της. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="20,12">
                <StackPanel Orientation="Horizontal">
                    <Button Content="←" FontSize="16" Style="{StaticResource GlyphButton}" Margin="0,0,14,0"
                            ToolTip="Πίσω" Command="{Binding BackCommand}"/>
                    <TextBlock Text="{Binding ActiveCategoryName}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock Text="{Binding ProductCountLabel}" FontSize="12" Foreground="{DynamicResource Neutral600}"
                               Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>
            </Border>

            <!-- Λίγος αέρας στο τέλος: χωρίς αυτόν η τελευταία σειρά κολλούσε στο κάτω χείλος και
                 φαινόταν κομμένη στη μέση, σαν να λείπει προϊόν. -->
            <!-- Περιθώριο γύρω-γύρω ώστε οι σκιές των καρτών να μην κόβονται στα χείλη -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="11,9,9,12">
                <!-- Χωρίς ItemsPanel: το προεπιλεγμένο StackPanel του ItemsControl στοιβάζει ήδη
                     κάθετα, μια σειρά ανά φαγητό. -->
                <ItemsControl ItemsSource="{Binding Tiles}" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProductTileViewModel}">
                            <Button Command="{Binding DataContext.TapProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    MouseDoubleClick="ProductRow_MouseDoubleClick"
                                    Style="{StaticResource ProductCard}"
                                    ToolTip="{Binding ListToolTip}">
                                <DockPanel LastChildFill="True">
                                    <!-- Πιο ελαφριά γράμματα, όπως στη μακέτα: με ExtraBold παντού η
                                         λίστα έβγαινε συμπαγής μαύρη μάζα και δεν ξεχώριζε τίποτα.
                                         Η τιμή πάει σε γκρι — τη διαβάζεις όταν τη γυρέψεις, δεν
                                         διεκδικεί το μάτι από το όνομα του φαγητού. -->
                                    <!-- Η τιμή σε δικό της «ταμπελάκι»: ξεχωρίζει από το όνομα χωρίς να
                                         χρειάζεται έντονα γράμματα, και η στήλη των τιμών διαβάζεται
                                         σαν στήλη — το μάτι τη βρίσκει αμέσως σε κάθε κάρτα. -->
                                    <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,3" Margin="10,0,0,0"
                                            VerticalAlignment="Center" Background="{DynamicResource Bg}">
                                        <TextBlock Text="{Binding PriceLabel}" FontSize="13.5"
                                                   FontWeight="Bold" Foreground="{DynamicResource Neutral700}"/>
                                    </Border>
                                    <Border DockPanel.Dock="Right" Width="26" Height="26" Margin="12,0,0,0"
                                            Background="{DynamicResource Accent}" CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasQty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Quantity}" Foreground="White"
                                                   FontWeight="ExtraBold" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <!-- Το badge ποσότητας δίπλα τρώει λίγο πλάτος όταν εμφανίζεται·
                                             με αποσιωπητικά το όνομα κονταίνει καθαρά αντί να κόβεται
                                             στη μέση μιας λέξης. -->
                                        <TextBlock Text="{Binding ShortName}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Ink}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding NameEn}" FontSize="11" Foreground="{DynamicResource Neutral500}"
                                                   Visibility="{Binding ShowEn, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ================= Υλικά/έξτρα — ανοίγουν ΔΙΠΛΑ στη λίστα ================= -->

        <!-- Όσο δεν έχει πατηθεί φαγητό η στήλη μένει σκέτη κενή — κρατάει μόνο τη θέση της, ώστε να
             μη μετακινείται η λίστα δίπλα. -->
        <Border Grid.Column="2" Background="{DynamicResource Bg}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="2,0,0,0"
                Visibility="{Binding IsTileGrid, Converter={StaticResource BoolToVis}}"/>

        <ContentControl Grid.Column="2" Content="{Binding Customizer}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTileGrid}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:CustomizerViewModel}">
                    <views:CustomizerView/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- ================= Ticket ================= -->
        <views:TicketView Grid.Column="3"/>
    </Grid>
</UserControl>
