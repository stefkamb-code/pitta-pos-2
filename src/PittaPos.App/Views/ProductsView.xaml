<UserControl x:Class="PittaPos.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
             xmlns:conv="clr-namespace:PittaPos.App.Converters"
             FontFamily="{StaticResource PosFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:UpperCaseGreekConverter x:Key="UpperCase"/>
    </UserControl.Resources>

    <Grid>
        <!-- Τέσσερις στήλες: κατηγορίες | λίστα φαγητών | υλικά | δελτίο.
             Η στήλη των υλικών κρατάει ΠΑΝΤΑ το πλάτος της, ακόμα και άδεια. Δοκιμάστηκε να μαζεύεται
             στο μηδέν όταν δεν υπάρχει επιλεγμένο φαγητό, αλλά τότε η λίστα φάρδαινε και στένευε σε
             κάθε άνοιγμα/κλείσιμο: τα ονόματα χοροπηδούσαν και ο ταμίας έχανε τη σειρά που κοίταζε. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Category rail ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,2,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryItemViewModel}">
                            <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch" Padding="14,9">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Name}" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Neutral700}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent800}"/>
                                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ================= Κάθετη λίστα φαγητών της κατηγορίας =================
             ΔΕΝ κρύβεται ποτέ. Παλιά ο customizer άνοιγε ακριβώς εδώ, στη θέση της λίστας, οπότε σε
             κάθε πίττα χανόταν από τα μάτια του ταμία ο κατάλογος και χρειαζόταν «πίσω» για την
             επόμενη. Τώρα τα υλικά ανοίγουν στη διπλανή στήλη και η λίστα μένει στη θέση της. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="20,12">
                <StackPanel Orientation="Horizontal">
                    <Button Content="←" FontSize="16" Style="{StaticResource GlyphButton}" Margin="0,0,14,0"
                            ToolTip="Πίσω" Command="{Binding BackCommand}"/>
                    <TextBlock Text="{Binding ActiveCategoryName}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock Text="{Binding ProductCountLabel}" FontSize="12" Foreground="{DynamicResource Neutral600}"
                               Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <!-- Χωρίς ItemsPanel: το προεπιλεγμένο StackPanel του ItemsControl στοιβάζει ήδη
                     κάθετα, μια σειρά ανά φαγητό. -->
                <ItemsControl ItemsSource="{Binding Tiles}" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProductTileViewModel}">
                            <Button Command="{Binding DataContext.TapProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    MouseDoubleClick="ProductRow_MouseDoubleClick"
                                    Padding="17,13" HorizontalAlignment="Stretch"
                                    ToolTip="{Binding ListToolTip}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <!-- Η κάτω γραμμή χωρίζει τις σειρές· η αριστερή μπάρα ανάβει
                                             κόκκινη στο φαγητό που έχει ανοιχτά τα υλικά του δίπλα. -->
                                        <Setter Property="BorderThickness" Value="4,0,0,2"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PriceLabel}" FontSize="16"
                                               FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <Border DockPanel.Dock="Right" Width="26" Height="26" Margin="12,0,0,0"
                                            Background="{DynamicResource Accent}" CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasQty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Quantity}" Foreground="White"
                                                   FontWeight="ExtraBold" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <!-- Το badge ποσότητας δίπλα τρώει λίγο πλάτος όταν εμφανίζεται·
                                             με αποσιωπητικά το όνομα κονταίνει καθαρά αντί να κόβεται
                                             στη μέση μιας λέξης. -->
                                        <TextBlock Text="{Binding ShortName}" FontSize="15" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Ink}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding NameEn}" FontSize="11" Foreground="{DynamicResource Neutral500}"
                                                   Visibility="{Binding ShowEn, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ================= Υλικά/έξτρα — ανοίγουν ΔΙΠΛΑ στη λίστα ================= -->

        <!-- Όσο δεν έχει πατηθεί φαγητό η στήλη μένει σκέτη κενή — κρατάει μόνο τη θέση της, ώστε να
             μη μετακινείται η λίστα δίπλα. -->
        <Border Grid.Column="2" Background="{DynamicResource Bg}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="2,0,0,0"
                Visibility="{Binding IsTileGrid, Converter={StaticResource BoolToVis}}"/>

        <ContentControl Grid.Column="2" Content="{Binding Customizer}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTileGrid}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:CustomizerViewModel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- header —
                             Σε δύο σειρές, όχι σε μία: η στήλη είναι πλέον στενή (ανοίγει δίπλα στη
                             λίστα, δεν πιάνει όλη τη μέση της οθόνης) και το όνομα σε μία σειρά μαζί
                             με ποσότητα+τιμή κοβόταν στη μέση — «Πίττα κοτόπου». Τώρα το όνομα έχει
                             όλο το πλάτος από κάτω και τυλίγεται αν χρειαστεί. -->
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="20,11">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <Button DockPanel.Dock="Left" Content="←" FontSize="18" Style="{StaticResource GlyphButton}"
                                            Command="{Binding CloseCommand}" Margin="0,0,12,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding UnitPriceLabel}" FontSize="19" FontWeight="ExtraBold"
                                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Accent700}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel Grid.Row="1" Margin="0,7,0,0">
                                    <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12"
                                            Background="{DynamicResource Surface}" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="−" Width="30" Height="32" Style="{StaticResource GlyphButton}" FontSize="17"
                                                    Command="{Binding DecQtyCommand}"/>
                                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1,0" Width="34">
                                                <TextBlock Text="{Binding Quantity}" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Content="+" Width="30" Height="32" Style="{StaticResource GlyphButton}" FontSize="17"
                                                    Foreground="{DynamicResource Accent}" Command="{Binding IncQtyCommand}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="ExtraBold"
                                               Foreground="{DynamicResource Ink}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- bread + sketo -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="20,12">
                            <!-- Χωρίς σταθερή ετικέτα «ΨΩΜΙ»: μία από τις ίδιες τις επιλογές λέγεται
                                 «Ψωμί», οπότε η ετικέτα δίπλα τους μπέρδευε (φαινόταν σαν να είναι
                                 επιλεγμένο το «Ψωμί»). Τα κουμπιά λένε ήδη μόνα τους τι είναι. -->
                            <!-- WrapPanel και όχι DockPanel: στη στενή στήλη τα ΣΚΕΤΟ/ΔΙΠΛΗ ΠΙΤΑ
                                 στρίμωχναν τις επιλογές ψωμιού και έκοβαν την τελευταία («Ψωμί») —
                                 έλειπε δηλαδή μια κανονική επιλογή χωρίς να φαίνεται πουθενά. Τώρα
                                 ό,τι δεν χωράει πέφτει σε δεύτερη σειρά αντί να κρύβεται. -->
                            <WrapPanel>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12"
                                        Margin="0,0,8,6">
                                    <ItemsControl ItemsSource="{Binding Breads}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BreadOptionViewModel}">
                                                <Button Content="{Binding Name}" Padding="13,7" FontSize="12.5" BorderThickness="0"
                                                        Command="{Binding SelectCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Neutral700}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Button Padding="14,7" Margin="0,0,8,6"
                                        Command="{Binding ToggleDoublePitaCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDoublePitaOption}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" BorderBrush="{DynamicResource Neutral400}" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDoublePita}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Ink}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding DoublePitaOptionLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Neutral700}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Padding="14,7" Margin="0,0,8,6"
                                        Command="{Binding ToggleSketoCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" BorderBrush="{DynamicResource Neutral400}" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="0,0,7,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSketo}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Ink}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="ΣΚΕΤΟ" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Neutral700}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <!-- included ingredients -->
                        <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="20,12,20,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                    <Rectangle Width="8" Height="8" Fill="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                    <TextBlock Text="ΥΛΙΚΑ" Style="{StaticResource SectionLabel}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Ingredients}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:IngredientViewModel}">
                                            <Button Margin="0,0,8,8" Padding="12,7"
                                                    Command="{Binding ToggleCommand}"
                                                    Style="{StaticResource FlatButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,7,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource Ink}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Neutral400}"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="✓" FontSize="9" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Neutral500}"/>
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- extras -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="20,11,20,9">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="ΕΞΤΡΑ" Style="{StaticResource SectionLabel}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,12">
                                <ItemsControl ItemsSource="{Binding VisibleExtras}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ExtraViewModel}">
                                            <Button Margin="0,0,10,10" Padding="13,9"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding TapCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="12" Height="24">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Content="−" Width="22" Style="{StaticResource GlyphButton}"
                                                                        Foreground="{DynamicResource Accent}"
                                                                        Command="{Binding DecCommand}"/>
                                                                <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1,0" Width="28">
                                                                    <TextBlock Text="{Binding QtyLabel}" FontWeight="ExtraBold" FontSize="12"
                                                                               Foreground="{DynamicResource Accent800}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Button Content="+" Width="22" Style="{StaticResource GlyphButton}"
                                                                        Foreground="{DynamicResource Accent}"
                                                                        Command="{Binding IncCommand}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PriceLabel}" FontSize="12"
                                                               Foreground="{DynamicResource Neutral600}" VerticalAlignment="Center" Margin="9,0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- bottom bar -->
                        <Border Grid.Row="4" BorderBrush="{DynamicResource Divider}" BorderThickness="0,2,0,0" Padding="20,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="48" MinWidth="220"
                                        Padding="20,0" Margin="12,0,0,0" Command="{Binding AddCommand}">
                                    <DockPanel LastChildFill="False" Width="180">
                                        <TextBlock DockPanel.Dock="Left" Text="ΠΡΟΣΘΗΚΗ" VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" FontSize="17" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Button>
                                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12"
                                        Height="40" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="−" Width="30" Style="{StaticResource GlyphButton}" FontSize="14"
                                                Command="{Binding DecDiscountCommand}"/>
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1,0">
                                            <TextBlock Text="{Binding DiscountLabel}" FontSize="11" FontWeight="ExtraBold"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                        </Border>
                                        <Button Content="+" Width="30" Style="{StaticResource GlyphButton}" FontSize="14"
                                                Foreground="{DynamicResource Accent}" Command="{Binding IncDiscountCommand}"/>
                                    </StackPanel>
                                </Border>
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Height="40" Padding="14,0"
                                        Margin="12,0,0,0" Command="{Binding ToggleNoChargeCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="13" Height="13" BorderBrush="{DynamicResource Neutral400}" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NoCharge}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Ink}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="Χωρίς χρέωση" FontSize="12.5" Foreground="{DynamicResource Neutral700}"/>
                                    </StackPanel>
                                </Button>
                                <TextBox Style="{StaticResource PosTextBox}" Height="40" VerticalAlignment="Center"
                                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- ================= Ticket ================= -->
        <Border Grid.Column="3" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="2,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="16,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CartCountLabel}" FontSize="11"
                                   Foreground="{DynamicResource Neutral600}" VerticalAlignment="Bottom"/>
                        <Button DockPanel.Dock="Right" Content="🔁" FontSize="15" Width="30" Height="30" Padding="0"
                                Style="{StaticResource GlyphButton}" Margin="0,0,10,0" ToolTip="Μία από τα ίδια"
                                Command="{Binding RepeatLastOrderCommand}"
                                Visibility="{Binding HasRepeatableOrder, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ΠΑΡΑΓΓΕΛΙΑ #" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <!-- Για ΕΦΑΡΜΟΓΕΣ με δηλωμένο αριθμό πλατφόρμας, δείχνει αυτόν αντί για τον
                                 εσωτερικό μας μετρητή — βλ. OrderWizardViewModel.DisplayOrderNumber. -->
                            <TextBlock Text="{Binding DataContext.DisplayOrderNumber, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0">
                    <StackPanel>
                        <TextBlock Text="Άδεια παραγγελία" FontSize="12.5" Foreground="{DynamicResource Neutral500}"
                                   HorizontalAlignment="Center" Margin="0,24"
                                   Visibility="{Binding CartEmpty, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CartLineViewModel}">
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                                        Background="{DynamicResource Bg}" Height="24" VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="−" Width="20" Style="{StaticResource GlyphButton}" FontSize="13"
                                                                Command="{Binding DataContext.DecLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1,0" Width="22">
                                                            <TextBlock Text="{Binding Quantity}" FontWeight="ExtraBold" FontSize="12"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Button Content="+" Width="20" Style="{StaticResource GlyphButton}" FontSize="13"
                                                                Foreground="{DynamicResource Accent}"
                                                                Command="{Binding DataContext.IncLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button DockPanel.Dock="Right" Content="×" FontSize="15" Style="{StaticResource GlyphButton}"
                                                        Foreground="{DynamicResource Neutral500}" ToolTip="Αφαίρεση είδους" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button DockPanel.Dock="Right" Content="✎" FontSize="12" Style="{StaticResource GlyphButton}"
                                                        Foreground="{DynamicResource Neutral500}" ToolTip="Επεξεργασία" VerticalAlignment="Top"
                                                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.EditLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" FontSize="14" FontWeight="ExtraBold"
                                                           Foreground="{DynamicResource Ink}" VerticalAlignment="Top" Margin="6,2,4,0"/>
                                                <TextBlock Text="{Binding Name, Converter={StaticResource UpperCase}}" FontSize="14" FontWeight="ExtraBold"
                                                           Foreground="{DynamicResource Ink}" Margin="9,2,0,0" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DescLine1, Converter={StaticResource UpperCase}}" FontSize="11.5" Foreground="{DynamicResource Neutral600}"
                                                       Margin="29,5,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasDesc, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding DescLine2, Converter={StaticResource UpperCase}}" FontSize="11.5" Foreground="{DynamicResource Accent700}"
                                                       Margin="29,1,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasMods, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- totals -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,2,0,0" Padding="16,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalLabel}" FontSize="13" Foreground="{DynamicResource Neutral700}"/>
                            <TextBlock Text="Υποσύνολο" FontSize="13" Foreground="{DynamicResource Neutral700}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5" Visibility="{Binding HasItemsDiscount, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ItemsDiscountLabel}" FontSize="13" Foreground="{DynamicResource Accent700}"/>
                            <TextBlock Text="Έκπτωση ειδών" FontSize="13" Foreground="{DynamicResource Neutral700}"/>
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,6,0,5">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12"
                                        Background="{DynamicResource Bg}" Height="30">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="−" Width="26" Style="{StaticResource GlyphButton}" FontSize="15"
                                                Command="{Binding DecOrderDiscountCommand}"/>
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Width="34" BorderThickness="0" Background="Transparent"
                                                         FontSize="13" FontWeight="ExtraBold" TextAlignment="Right"
                                                         VerticalContentAlignment="Center" Foreground="{DynamicResource Ink}"
                                                         Text="{Binding OrderDiscountPct, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="%" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="+" Width="26" Style="{StaticResource GlyphButton}" FontSize="15"
                                                Foreground="{DynamicResource Accent}" Command="{Binding IncOrderDiscountCommand}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="ΕΚΠΤΩΣΗ ΠΑΡΑΓΓΕΛΙΑΣ" FontSize="10" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"/>
                                    <TextBlock Text="{Binding OrderDiscountLabel}" FontSize="13" FontWeight="ExtraBold"
                                               Foreground="{DynamicResource Accent700}" Margin="0,2,0,0"
                                               Visibility="{Binding HasOrderDiscount, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,2,0,0" Padding="0,9,0,0" Margin="0,6,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" FontSize="23" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                <TextBlock Text="ΣΥΝΟΛΟ" FontSize="16" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Bottom"/>
                            </DockPanel>
                        </Border>

                        <!-- order note: μόνο για ΤΡΑΠΕΖΙ/ΠΑΡΑΛΑΒΗ, που δεν έχουν Βήμα 2 -->
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding DataContext.ShowOrderNoteButton, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <Button Content="💬 ΣΧΟΛΙΑ ΠΑΡΑΓΓΕΛΙΑΣ" Style="{StaticResource FlatButton}" Padding="12,8"
                                    FontSize="12.5" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                                    Command="{Binding ToggleNoteFieldCommand}"/>
                            <TextBox Style="{StaticResource PosTextBox}" Height="60" Margin="0,8,0,0"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8,6"
                                     Visibility="{Binding ShowNoteField, Converter={StaticResource BoolToVis}}"
                                     Text="{Binding DataContext.CustomerNotes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- actions -->
                <StackPanel Grid.Row="3" Margin="16,0,16,16">
                    <Button Style="{StaticResource PrimaryButton}" Padding="14,13" FontSize="14"
                            IsEnabled="{Binding CartNotEmpty}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" Command="{Binding ContinueCommand}">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding ContinueLabel}"/>
                            <TextBlock DockPanel.Dock="Right" Text="→"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Content="← Πίσω" FontSize="12.5"
                            Margin="0,8,0,0" Padding="12,8" HorizontalAlignment="Stretch"
                            Command="{Binding BackCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
