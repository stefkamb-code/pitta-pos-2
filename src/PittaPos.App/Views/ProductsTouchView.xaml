<UserControl x:Class="PittaPos.App.Views.ProductsTouchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
             xmlns:views="clr-namespace:PittaPos.App.Views"
             FontFamily="{StaticResource PosFont}">
    <!-- ΟΘΟΝΗ ΑΦΗΣ (Ρυθμίσεις → ΕΜΦΑΝΙΣΗ → ΟΘΟΝΗ ΑΦΗΣ): η οθόνη παραγγελίας όπως στο πρώτο PittaPOS — μεγάλες κάρτες σε
         πλέγμα, και τα υλικά ανοίγουν στη μέση, στη θέση των καρτών. Ίδιο ProductsViewModel με τη λίστα του ποντικιού
         (ProductsView), ίδια υλικά (CustomizerView) και ίδιο δελτίο (TicketView): αλλάζει ΜΟΝΟ το πώς το βλέπεις και
         το πατάς. Στο δάχτυλο δεν υπάρχει διπλό κλικ, οπότε:
           · ένα πάτημα σε ποτό/σαλάτα/μίνι = μπαίνει στο δελτίο,
           · ένα πάτημα σε φαγητό με υλικά = ανοίγουν τα υλικά (ΠΡΟΣΘΗΚΗ → πίσω στις κάρτες),
           · το «+» πάνω δεξιά στην κάρτα = το φαγητό μπαίνει με τα προεπιλεγμένα του, χωρίς υλικά. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <ControlTemplate x:Key="TouchCardTemplate" TargetType="Button">
            <Grid>
                <Border Background="{TemplateBinding Background}" CornerRadius="14"
                        Effect="{StaticResource SoftShadowSmall}"/>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Border>
            </Grid>
        </ControlTemplate>

        <Style x:Key="TouchCard" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Template" Value="{StaticResource TouchCardTemplate}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinHeight" Value="104"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasQty}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- κατηγορίες | κάρτες ή υλικά | δελτίο -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*" MinWidth="560"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Κατηγορίες — ψηλότερες, για το δάχτυλο ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,2,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoryItemViewModel}">
                            <Button Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch" Padding="16,15">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="8,2,8,2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Name}" FontSize="15" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Neutral700}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ================= Κάρτες σε πλέγμα ================= -->
        <Grid Grid.Column="1" Visibility="{Binding IsTileGrid, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="20,12">
                <StackPanel Orientation="Horizontal">
                    <Button Content="←" FontSize="18" Style="{StaticResource GlyphButton}" Margin="0,0,14,0"
                            Width="44" Height="40" ToolTip="Πίσω" Command="{Binding BackCommand}"/>
                    <TextBlock Text="{Binding ActiveCategoryName}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProductCountLabel}" FontSize="12" Foreground="{DynamicResource Neutral600}"
                               Margin="10,0,0,3" VerticalAlignment="Bottom"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Padding="18,16,6,8">
                <ItemsControl ItemsSource="{Binding Tiles}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProductTileViewModel}">
                            <Button Style="{StaticResource TouchCard}" ToolTip="{Binding Description}"
                                    Command="{Binding DataContext.TouchTapProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="16" FontWeight="ExtraBold"
                                               Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,0,44,0"/>
                                    <TextBlock Grid.Row="1" Text="{Binding NameEn}" FontSize="11" Foreground="{DynamicResource Neutral500}"
                                               Margin="0,2,44,0" TextWrapping="Wrap"
                                               Visibility="{Binding ShowEn, Converter={StaticResource BoolToVis}}"/>
                                    <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,10,0,0">
                                        <Border DockPanel.Dock="Left" Width="30" Height="30"
                                                Background="{DynamicResource Accent}" CornerRadius="7"
                                                Visibility="{Binding HasQty, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Quantity}" Foreground="White"
                                                       FontWeight="ExtraBold" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PriceLabel}" FontSize="18"
                                                   FontWeight="ExtraBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Bottom"/>
                                    </DockPanel>
                                    <!-- «+» = με τα προεπιλεγμένα, χωρίς υλικά. Μόνο σε φαγητά με υλικά: στα υπόλοιπα
                                         το ίδιο το πάτημα της κάρτας ήδη προσθέτει. -->
                                    <Button Grid.Row="0" Grid.RowSpan="2" Content="+" Width="40" Height="40" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                            FontSize="22" FontWeight="ExtraBold" ToolTip="Με τα προεπιλεγμένα"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Style="{StaticResource FlatButton}"
                                            Visibility="{Binding Customizable, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.TouchQuickAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ================= Υλικά — στη μέση, στη θέση των καρτών ================= -->
        <ContentControl Grid.Column="1" Content="{Binding Customizer}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTileGrid}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:CustomizerViewModel}">
                    <views:CustomizerView/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- ================= Δελτίο ================= -->
        <views:TicketView Grid.Column="2"/>
    </Grid>
</UserControl>
