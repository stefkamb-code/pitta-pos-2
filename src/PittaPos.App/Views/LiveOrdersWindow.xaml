<Window x:Class="PittaPos.App.Views.LiveOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
        xmlns:svc="clr-namespace:PittaPos.App.Services"
        Title="ΖΩΝΤΑΝΕΣ ΠΑΡΑΓΓΕΛΙΕΣ" Height="800" Width="660"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png"
                       Height="32" Margin="0,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="ΖΩΝΤΑΝΕΣ ΠΑΡΑΓΓΕΛΙΕΣ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Fill="#2e7d32"
                         Margin="14,0,0,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding NowLabel}" FontSize="13" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral700}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="🗺 ΧΑΡΤΗΣ" FontSize="12" FontWeight="ExtraBold" Padding="12,6"
                        Style="{StaticResource FlatButton}" Command="{Binding OpenMapCommand}"/>
                <Button DockPanel.Dock="Right" Content="🖨 ΕΚΤΥΠΩΣΕΙΣ ΔΙΑΝΟΜΕΑ" FontSize="12" FontWeight="ExtraBold" Padding="12,6"
                        Margin="0,0,8,0" Style="{StaticResource FlatButton}" Command="{Binding PrintDriverReportCommand}"/>
                <!-- Πόσα μετρητά πρέπει να έχει πάνω του ο διανομέας αυτή τη στιγμή — βλ. CashOnDeliveryLabel. -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding CashOnDeliveryLabel}" FontSize="12.5" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center" Margin="0,0,14,0"
                           Visibility="{Binding HasCashOnDelivery, Converter={StaticResource BoolToVis}}"/>
                <Border/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" MinWidth="260"/>
                <ColumnDefinition Width="1*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- pending list -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,14">
                        <TextBlock Text="Παραγγελίες σε αναμονή" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Καμία παραγγελία σε αναμονή" FontSize="12.5" Foreground="{DynamicResource Neutral500}"
                                       HorizontalAlignment="Center" Margin="0,24"
                                       Visibility="{Binding NoPending, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding PendingOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type svc:BoardOrder}">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="16,14" BorderThickness="0,0,0,1"
                                                Command="{Binding DataContext.SelectOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{x:Static vm:SameObjectConverter.Instance}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.SelectedOrder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedLabel}" FontSize="15"
                                                               FontWeight="ExtraBold" Foreground="{Binding ElapsedBrush}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="#" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                                        <!-- Για ΕΦΑΡΜΟΓΕΣ με δηλωμένο αριθμό πλατφόρμας, αυτός είναι ο κύριος αριθμός
                                                             (πιο χρήσιμος για Wolt/e-food/BOX) — βλ. BoardOrder.DisplayNumber. -->
                                                        <TextBlock Text="{Binding DisplayNumber}" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                                        <TextBlock Text=" · " FontSize="13" Foreground="{DynamicResource Neutral500}"/>
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                                        <!-- Μετρητά/κάρτα — μόνο ΔΙΑΝΟΜΗ/BOX, βλ. BoardOrder.PaymentIcon -->
                                                        <TextBlock Text="{Binding PaymentIcon}" FontSize="13" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalLabel}" FontSize="13"
                                                               FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Address}" FontSize="11.5" Foreground="{DynamicResource Neutral600}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- right pane -->
            <Grid Grid.Column="1" Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- selected order: dispatch -->
                <StackPanel Grid.Row="0" Visibility="{Binding HasSelectedOrder, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}" Margin="0,0,0,6">
                        <Run Text="ΠΑΡΑΓΓΕΛΙΑ #"/><Run Text="{Binding SelectedOrder.DisplayNumber, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedOrder.Name}" FontSize="22" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock Text="{Binding SelectedOrder.Address}" FontSize="13" Foreground="{DynamicResource Neutral600}" Margin="0,2,0,4"/>
                    <!-- Πραγματική διαγραφή — π.χ. ο πελάτης ακύρωσε πριν προλάβει να περάσει σε κανάλι.
                         Μόνο με ονομαστικό κωδικό (βλ. CancelPendingOrder_Click), ίδια λογική με το τραπέζι. -->
                    <Button Content="✕ ΑΚΥΡΩΣΗ ΠΑΡΑΓΓΕΛΙΑΣ" FontSize="11" FontWeight="ExtraBold" Padding="10,6"
                            HorizontalAlignment="Left" Margin="0,0,0,20" Foreground="{DynamicResource Accent}"
                            Style="{StaticResource FlatButton}" Click="CancelPendingOrder_Click"/>
                    <TextBlock Text="ΠΕΡΑΣΕ ΤΗΝ ΣΕ" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding DispatchOptions}" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChannelButtonViewModel}">
                                <Button Content="{Binding Name}" Command="{Binding Command}"
                                        BorderThickness="2" Padding="16"
                                        FontSize="13.5" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                                        Margin="0,0,10,10" MinWidth="150">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                            <Setter Property="Foreground" Value="{Binding Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="Διανομέας">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="Κάρτα Διανομέα">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- selected channel: orders in channel -->
                <Grid Grid.Row="0" Visibility="{Binding HasSelectedChannel, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                        <Button Content="←" FontSize="16" Style="{StaticResource GlyphButton}" Command="{Binding ClearChannelCommand}"/>
                        <TextBlock Text="{Binding SelectedChannel}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Ink}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Καμία παραγγελία σε αυτό το κανάλι" FontSize="13" Foreground="{DynamicResource Neutral500}"
                                       Margin="0,24" Visibility="{Binding NoChannelOrders, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding ChannelOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChannelOrderViewModel}">
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Order.TotalLabel}" FontSize="13"
                                                               FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="#" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                                        <TextBlock Text="{Binding Order.DisplayNumber}" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                                        <TextBlock Text=" · " FontSize="13" Foreground="{DynamicResource Neutral500}"/>
                                                        <TextBlock Text="{Binding Order.Name}" FontSize="13" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <StackPanel Margin="0,8,0,0">
                                                    <Button Content="ΑΛΛΑΓΗ ΣΕ" Command="{Binding ToggleReassignOptionsCommand}"
                                                            HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                                                            Padding="10,5" FontSize="11" FontWeight="ExtraBold"/>

                                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowReassignOptions, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Αλλαγή σε:" FontSize="10.5" Foreground="{DynamicResource Neutral500}"
                                                                   Margin="0,0,0,5"/>
                                                        <ItemsControl ItemsSource="{Binding ReassignOptions}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:ChannelButtonViewModel}">
                                                                    <Button Content="{Binding Name}" Command="{Binding Command}"
                                                                            Padding="10,5" Margin="0,0,8,8"
                                                                            FontSize="11" FontWeight="ExtraBold">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                                                <Setter Property="Foreground" Value="{Binding Brush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="Διανομέας">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="Κάρτα Διανομέα">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Content="↩ Αναμονή" Command="{Binding RevertCommand}" HorizontalAlignment="Left"
                                                                Style="{StaticResource FlatButton}" Padding="10,5" Margin="0,2,8,0"
                                                                FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"/>
                                                        <!-- Πραγματική διαγραφή — π.χ. ο πελάτης ακύρωσε αφού είχε ήδη περάσει σε κανάλι.
                                                             Μόνο με ονομαστικό κωδικό (βλ. CancelChannelOrder_Click). -->
                                                        <Button Content="✕ Ακύρωση" HorizontalAlignment="Left"
                                                                Style="{StaticResource FlatButton}" Padding="10,5" Margin="0,2,0,0"
                                                                FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource Accent}"
                                                                Click="CancelChannelOrder_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- nothing selected -->
                <TextBlock Grid.Row="0" Text="Επίλεξε παραγγελία από τη λίστα" FontSize="13" Foreground="{DynamicResource Neutral500}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NothingSelected, Converter={StaticResource BoolToVis}}"/>

            </Grid>

            <!-- channel rail: κάθετα, τέρμα δεξιά -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource Divider}" BorderThickness="2,0,0,0" Width="132">
                <DockPanel>
                    <!-- shift toggle: φιλτράρει μόνο τα box e-food / Wolt / BOX -->
                    <StackPanel DockPanel.Dock="Top" Margin="10,14,10,4">
                        <!-- Ίδια έγχρωμα σήματα με την κεφαλίδα του ταμείου (βλ. MainWindow.xaml). -->
                        <Button FontSize="9.5" FontWeight="ExtraBold" Height="30"
                                Padding="2,0" Margin="0,0,0,6" Command="{Binding SelectMorningShiftCommand}">
                            <TextBlock><Run Text="&#x2600;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{DynamicResource SunGold}"/><Run Text=" ΠΡΩΙΝΗ"/></TextBlock>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEveningShift}" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button FontSize="9.5" FontWeight="ExtraBold" Height="30"
                                Padding="2,0" Command="{Binding SelectEveningShiftCommand}">
                            <TextBlock><Run Text="&#x1F319;" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{DynamicResource MoonBlue}"/><Run Text=" ΒΡΑΔΙΝΗ"/></TextBlock>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEveningShift}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Night}"/>
                                            <Setter Property="Background" Value="{DynamicResource NightBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Night}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChannelStats}" Margin="12,10,12,22">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChannelButtonViewModel}">
                                <Button Command="{Binding Command}" Style="{StaticResource FlatButton}"
                                        Padding="8,12" Margin="0,0,0,10" HorizontalContentAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding Brush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="Διανομέας">
                                                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="Κάρτα Διανομέα">
                                                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CountSumLabel}" FontSize="14" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
