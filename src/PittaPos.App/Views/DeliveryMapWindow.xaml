<Window x:Class="PittaPos.App.Views.DeliveryMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ΧΑΡΤΗΣ ΔΙΑΝΟΜΗΣ" Height="760" Width="900"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <TextBlock DockPanel.Dock="Left" Text="🗺 ΧΑΡΤΗΣ ΔΙΑΝΟΜΗΣ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="↻ ΑΝΑΝΕΩΣΗ" FontSize="12" FontWeight="ExtraBold"
                        Style="{StaticResource FlatButton}" Padding="14,6" Click="Refresh_Click"/>
                <!-- Διόρθωση λάθος πινέζας: η αναζήτηση διεύθυνσης δεν βρίσκει πάντα τη σωστή πόρτα, οπότε
                     ο ταμίας τη δείχνει ο ίδιος μία φορά και μένει έτσι για πάντα (βλ. AddressPointsService). -->
                <Button x:Name="FixPinBtn" DockPanel.Dock="Right" Content="📍 ΔΙΟΡΘΩΣΗ ΣΗΜΕΙΟΥ" FontSize="12" FontWeight="ExtraBold"
                        Style="{StaticResource FlatButton}" Padding="14,6" Margin="0,0,8,0" Click="FixPin_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Map"/>
            <!-- Η γεωκωδικοποίηση κάθε στάσης περνάει από το δωρεάν Nominatim με σεβασμό στο όριο
                 <=1 αίτημα/δευτ. — με αρκετές παραγγελίες μπορεί να πάρει μερικά δευτερόλεπτα, χωρίς αυτό
                 φαινόταν σαν κολλημένη λευκή σελίδα αντί για «φορτώνει». -->
            <Border x:Name="LoadingOverlay" Background="{DynamicResource Bg}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                    <TextBlock x:Name="LoadingIcon" Text="🗺" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="LoadingText" Text="Φόρτωση χάρτη..." FontSize="13.5" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Neutral700}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="RetryButton" Content="↻ ΞΑΝΑΔΟΚΙΜΗ" FontSize="12" FontWeight="ExtraBold"
                            Style="{StaticResource FlatButton}" Padding="14,6" Margin="0,14,0,0"
                            Visibility="Collapsed" Click="Retry_Click"/>
                </StackPanel>
            </Border>
            <!-- Μικρή, μη μπλοκαριστική ένδειξη πάνω από τον ήδη ορατό χάρτη όσο διαρκεί η γεωκωδικοποίηση
                 των στάσεων (βλ. DeliveryRouteService) — ο ταμίας βλέπει τον χάρτη αμέσως αντί να περιμένει
                 μπλοκαρισμένη οθόνη μέχρι να προστεθούν οι πινέζες. -->
            <Border x:Name="PinsLoadingBadge" Background="{DynamicResource Bg}" Opacity="0.92"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                    Padding="16,8" Visibility="Collapsed">
                <TextBlock Text="Φόρτωση σημείων παράδοσης..." FontSize="12" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral700}"/>
            </Border>
            <!-- Παραγγελίες που ΔΕΝ μπήκαν στον χάρτη επειδή δεν εντοπίστηκε η διεύθυνσή τους. Πριν, το
                 DeliveryRouteResult.FailedAddresses γέμιζε κανονικά αλλά δεν το διάβαζε κανείς: η
                 παραγγελία εξαφανιζόταν σιωπηλά από τον χάρτη και ο ταμίας νόμιζε ότι δεν καταχωρήθηκε.
                 Κόκκινο και με τον αριθμό παραγγελίας, ώστε να ξέρει ΠΟΙΑ να ψάξει χειροκίνητα. -->
            <!-- Επιλογή παραγγελίας για διόρθωση σημείου — ένα παραθυράκι στη μέση, όχι κουμπιά παντού. -->
            <Border x:Name="FixPinPanel" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="2" CornerRadius="14" Padding="20" MaxWidth="420" MaxHeight="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ΠΟΙΑΣ ΠΑΡΑΓΓΕΛΙΑΣ ΤΟ ΣΗΜΕΙΟ;" FontSize="13" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Ink}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="Διάλεξε παραγγελία και μετά πάτα στον χάρτη τη σωστή θέση."
                               FontSize="11.5" Foreground="{DynamicResource Neutral600}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button DockPanel.Dock="Bottom" Content="ΑΚΥΡΟ" FontSize="12" FontWeight="ExtraBold"
                            Style="{StaticResource FlatButton}" Padding="14,8" Margin="0,12,0,0"
                            HorizontalAlignment="Right" Click="CancelFixPin_Click"/>
                    <ListBox x:Name="FixPinList" BorderThickness="0" Background="Transparent" FontSize="12.5"
                             MaxHeight="280" SelectionChanged="FixPinList_SelectionChanged"/>
                </DockPanel>
            </Border>
            <!-- Οδηγία όσο ο ταμίας διαλέγει σημείο πάνω στον χάρτη. -->
            <Border x:Name="PickPointBadge" Background="{DynamicResource Ink}" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                    Padding="16,10" Visibility="Collapsed">
                <TextBlock x:Name="PickPointText" FontSize="12.5" FontWeight="ExtraBold" Foreground="White"/>
            </Border>
            <Border x:Name="FailedAddressesBadge" Background="{DynamicResource Accent}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16"
                    Padding="16,10" CornerRadius="10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="FailedAddressesTitle" FontSize="12.5" FontWeight="ExtraBold"
                               Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FailedAddressesList" FontSize="11.5" Foreground="White"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
