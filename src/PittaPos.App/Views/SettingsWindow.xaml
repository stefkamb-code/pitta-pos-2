<Window x:Class="PittaPos.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ΡΥΘΜΙΣΕΙΣ" Height="600" Width="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png"
                       Height="32" Margin="0,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="ΡΥΘΜΙΣΕΙΣ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Border/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,26" MaxWidth="520" HorizontalAlignment="Left">

                <!-- security -->
                <TextBlock Text="ΑΣΦΑΛΕΙΑ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Button Content="ΑΛΛΑΓΗ ΚΩΔΙΚΟΥ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="ChangePin_Click"/>
                <TextBlock Text="Κωδικός 4 ψηφίων για Στατιστικά, Ιστορικό και Κατάλογο."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <Button Content="ΚΩΔΙΚΟΙ ΑΚΥΡΩΣΗΣ ΠΡΟΣΩΠΙΚΟΥ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="ManageCancelStaff_Click"/>
                <TextBlock Text="Μόνο για τον admin (θέλει τον παραπάνω κωδικό καταστήματος) — 4 ονόματα με δικό τους κωδικό ακύρωσης, ώστε το ιστορικό ακυρωμένων να δείχνει ποιος ακύρωσε."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- receipt content -->
                <TextBlock Text="ΑΠΟΔΕΙΞΗ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Button Content="ΚΑΤΑΣΚΕΥΗ ΑΠΟΔΕΙΞΗΣ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="OpenReceipt_Click"/>
                <TextBlock Text="Τίτλος, στοιχεία καταστήματος, υποσέλιδο και τι εμφανίζεται — με ζωντανή προεπισκόπηση."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- printer -->
                <TextBlock Text="ΕΚΤΥΠΩΤΗΣ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <!-- Style="PosComboBox" ΑΠΑΡΑΙΤΗΤΟ: χωρίς αυτό το dropdown ήταν το προεπιλεγμένο των
                     Windows, με ΛΕΥΚΟ φόντο. Στο μαύρο θέμα το κείμενο γίνεται ανοιχτόχρωμο, οπότε τα
                     ονόματα των εκτυπωτών έβγαιναν λευκά πάνω σε λευκό — η λίστα φαινόταν άδεια και το
                     ταμείο έμοιαζε να «μη βλέπει εκτυπωτή». Το δικό μας style φέρνει και σκούρο popup. -->
                <ComboBox x:Name="PrinterCombo" Style="{StaticResource PosComboBox}"
                          Height="46" FontSize="14" Width="320" HorizontalAlignment="Left"
                          DisplayMemberPath="Display"
                          SelectionChanged="PrinterCombo_SelectionChanged"/>
                <TextBlock Text="Ο εκτυπωτής που θα τυπώνει αυτόματα τις αποδείξεις, χωρίς να ζητά επιβεβαίωση κάθε φορά."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- tables -->
                <TextBlock Text="ΤΡΑΠΕΖΙΑ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10"
                        HorizontalAlignment="Left" Height="52">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Width="44" Style="{StaticResource GlyphButton}" FontSize="18"
                                Click="DecTableCount_Click"/>
                        <TextBlock x:Name="TableCountText" Width="50" FontSize="18" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Width="44" Style="{StaticResource GlyphButton}" FontSize="18"
                                Foreground="{DynamicResource Accent}" Click="IncTableCount_Click"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Πόσα τραπέζια δείχνει το Βήμα 1 όταν επιλέγεται «ΤΡΑΠΕΖΙ»."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- network -->
                <TextBlock Text="ΔΙΚΤΥΟ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Button Content="ΡΥΘΜΙΣΕΙΣ ΔΙΚΤΥΟΥ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="OpenNetwork_Click"/>
                <TextBlock Text="Διεύθυνση για το Android app σερβιτόρου, αναγνώριση κλήσεων (UCM) και σύνδεση δεύτερου ταμείου."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- day close -->
                <TextBlock Text="ΤΑΜΕΙΟ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Button Content="ΕΚΤΥΠΩΣΗ ΑΝΑΦΟΡΑΣ ΤΩΡΑ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="CloseDay_Click"/>
                <TextBlock Text="Τυπώνει την αναφορά τζίρου μέχρι αυτή τη στιγμή — δεν μηδενίζει τίποτα, μπορείς να την τυπώνεις όσες φορές θες μέσα στη μέρα. Το πραγματικό κλείσιμο/μηδενισμός του ταμείου γίνεται μόνο αυτόματα στις 5:00 το πρωί."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- theme -->
                <TextBlock Text="ΕΜΦΑΝΙΣΗ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="LightBtn" Content="☀ ΛΕΥΚΟ" Height="52" FontSize="14" FontWeight="ExtraBold"
                            Style="{StaticResource FlatButton}" HorizontalContentAlignment="Center" Click="Light_Click"/>
                    <Button Grid.Column="2" x:Name="DarkBtn" Content="🌙 ΜΑΥΡΟ" Height="52" FontSize="14" FontWeight="ExtraBold"
                            Style="{StaticResource FlatButton}" HorizontalContentAlignment="Center" Click="Dark_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
