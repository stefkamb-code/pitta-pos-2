<Window x:Class="PittaPos.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PittaPos.App.Controls"
        Title="ΡΥΘΜΙΣΕΙΣ" Height="600" Width="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <!-- Ολο το περιεχομενο μεγαλωνει/μικραινει μαζι με το παραθυρο, ΚΑΙ απλωνει στον χωρο που
         υπαρχει (βλ. Controls/ScaleHost) — γραμματα, κουμπια και αποστασεις στην ιδια αναλογια. -->
    <ctl:ScaleHost DesignWidth="624" DesignHeight="561">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png"
                       Height="32" Margin="0,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="ΡΥΘΜΙΣΕΙΣ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Border/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,26" MaxWidth="520" HorizontalAlignment="Left">

                <!-- security -->
                <TextBlock Text="ΑΣΦΑΛΕΙΑ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <!-- Ο παλιός «κωδικός καταστήματος» καταργήθηκε: τα πάντα ανοίγουν με τον κωδικό
                     admin ή με τον προσωπικό κωδικό του καθενός (βλ. ΚΩΔΙΚΟΙ ΠΡΟΣΩΠΙΚΟΥ παρακάτω). -->

                <Button Content="ΚΩΔΙΚΟΙ ΠΡΟΣΩΠΙΚΟΥ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="ManageCancelStaff_Click"/>
                <TextBlock Text="Μόνο για τον admin (θέλει τον παραπάνω κωδικό καταστήματος) — 4 ονόματα με δικό τους κωδικό ακύρωσης, ώστε το ιστορικό ακυρωμένων να δείχνει ποιος ακύρωσε."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- receipt content -->
                <TextBlock Text="ΑΠΟΔΕΙΞΗ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Button Content="ΚΑΤΑΣΚΕΥΗ ΑΠΟΔΕΙΞΗΣ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="OpenReceipt_Click"/>
                <TextBlock Text="Τίτλος, στοιχεία καταστήματος, υποσέλιδο και τι εμφανίζεται — με ζωντανή προεπισκόπηση."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- printer -->
                <TextBlock Text="ΕΚΤΥΠΩΤΗΣ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <!-- Style="PosComboBox" ΑΠΑΡΑΙΤΗΤΟ: χωρίς αυτό το dropdown ήταν το προεπιλεγμένο των
                     Windows, με ΛΕΥΚΟ φόντο. Στο μαύρο θέμα το κείμενο γίνεται ανοιχτόχρωμο, οπότε τα
                     ονόματα των εκτυπωτών έβγαιναν λευκά πάνω σε λευκό — η λίστα φαινόταν άδεια και το
                     ταμείο έμοιαζε να «μη βλέπει εκτυπωτή». Το δικό μας style φέρνει και σκούρο popup. -->
                <ComboBox x:Name="PrinterCombo" Style="{StaticResource PosComboBox}"
                          Height="46" FontSize="14" Width="320" HorizontalAlignment="Left"
                          DisplayMemberPath="Display"
                          SelectionChanged="PrinterCombo_SelectionChanged"/>
                <TextBlock Text="Ο εκτυπωτής που θα τυπώνει αυτόματα τις αποδείξεις, χωρίς να ζητά επιβεβαίωση κάθε φορά."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- tables -->
                <TextBlock Text="ΤΡΑΠΕΖΙΑ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10"
                        HorizontalAlignment="Left" Height="52">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Width="44" Style="{StaticResource GlyphButton}" FontSize="18"
                                Click="DecTableCount_Click"/>
                        <TextBlock x:Name="TableCountText" Width="50" FontSize="18" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Width="44" Style="{StaticResource GlyphButton}" FontSize="18"
                                Foreground="{DynamicResource Accent}" Click="IncTableCount_Click"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Πόσα τραπέζια δείχνει το Βήμα 1 όταν επιλέγεται «ΤΡΑΠΕΖΙ»."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- network -->
                <TextBlock Text="ΔΙΚΤΥΟ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Button Content="ΡΥΘΜΙΣΕΙΣ ΔΙΚΤΥΟΥ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="OpenNetwork_Click"/>
                <TextBlock Text="Διεύθυνση για το Android app σερβιτόρου, αναγνώριση κλήσεων (UCM) και σύνδεση δεύτερου ταμείου."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- day close -->
                <TextBlock Text="ΤΑΜΕΙΟ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Button Content="ΕΚΤΥΠΩΣΗ ΑΝΑΦΟΡΑΣ ΤΩΡΑ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="CloseDay_Click"/>
                <TextBlock Text="Τυπώνει την αναφορά τζίρου μέχρι αυτή τη στιγμή — δεν μηδενίζει τίποτα, μπορείς να την τυπώνεις όσες φορές θες μέσα στη μέρα. Το πραγματικό κλείσιμο/μηδενισμός του ταμείου γίνεται μόνο αυτόματα στις 5:00 το πρωί."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <Button Content="ΑΠΟΣΤΟΛΗ ΑΝΑΦΟΡΑΣ ΣΤΟ EMAIL" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="SendReport_Click"/>
                <TextBlock Text="Ο ΜΟΝΟΣ τρόπος να φύγει η αναφορά με email — το κλείσιμο ημέρας δεν στέλνει τίποτα μόνο του. Δεν μηδενίζει και δεν κλείνει τίποτα, μπορείς να το πατήσεις όσες φορές θες."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                <TextBlock x:Name="SendReportStatus" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,26"
                           Foreground="{DynamicResource Neutral500}"/>

                <!-- report email -->
                <TextBlock Text="EMAIL ΑΝΑΦΟΡΑΣ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Button Content="EMAIL ΑΝΑΦΟΡΑΣ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="OpenEmail_Click"/>
                <TextBlock Text="Σε ποιο mail θα φτάνει η αναλυτική αναφορά ημέρας όταν πατάς «ΑΠΟΣΤΟΛΗ ΑΝΑΦΟΡΑΣ ΣΤΟ EMAIL», και από ποιον λογαριασμό θα στέλνεται."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- e-food -->
                <TextBlock Text="E-FOOD" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Button Content="E-FOOD" Height="52" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="OpenEfood_Click"/>
                <TextBlock Text="Σύνδεση με τη γέφυρα e-food: οι παραγγελίες μπαίνουν και τυπώνονται μόνες τους. Ανοίγει με τον κωδικό του ιδιοκτήτη."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,8,0,26"/>

                <!-- theme -->
                <TextBlock Text="ΕΜΦΑΝΙΣΗ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="LightBtn" Content="☀ ΛΕΥΚΟ" Height="52" FontSize="14" FontWeight="ExtraBold"
                            Style="{StaticResource FlatButton}" HorizontalContentAlignment="Center" Click="Light_Click"/>
                    <Button Grid.Column="2" x:Name="DarkBtn" Content="🌙 ΜΑΥΡΟ" Height="52" FontSize="14" FontWeight="ExtraBold"
                            Style="{StaticResource FlatButton}" HorizontalContentAlignment="Center" Click="Dark_Click"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= ανεξόφλητα — banner στη μέση, πάνω από όλα ================= -->
        <!-- Σηκώνεται ΠΡΙΝ φύγει το email, ΜΟΝΟ όταν η μέρα έχει λεφτά χωρίς είσπραξη (βλ.
             SendReport_Click / DayReportService.UnsettledToday). Ίδια φόρμα με το banner τρόπου
             πληρωμής του ταμείου (MainWindow.xaml) — σκοτεινό φόντο, μία κάρτα στη μέση.
             Χωρίς αυτό, το νούμερο υπήρχε μόνο μέσα στο κείμενο της αναφοράς: όποιος πατούσε αποστολή
             δεν είχε λόγο να ανοίξει το email του και το ανεξόφλητο τραπέζι περνούσε απαρατήρητο —
             και το email είχε ήδη φύγει λάθος. -->
        <Grid x:Name="UnsettledBanner" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="200" Visibility="Collapsed">
            <Border Background="#99000000"/>
            <Border Width="440" Background="{DynamicResource Bg}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="22"
                    Effect="{StaticResource SoftShadowSmall}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Τα μεγέθη είναι μετρημένα ώστε η κάρτα να χωράει ΟΛΟΚΛΗΡΗ στο παράθυρο (σχεδίαση
                     624×561) ακόμα και με γεμάτη τη λίστα: τα σταθερά κομμάτια πιάνουν ~335 και το
                     MaxHeight της λίστας κόβει τα υπόλοιπα. -->
                <StackPanel Margin="28,24,28,26">
                    <!-- Σκέτο «€» και όχι emoji προειδοποίησης: το ⚠ το ζωγραφίζει το Windows με τα
                         δικά του χρώματα (κόκκινο τρίγωνο) και χανόταν μέσα στον κόκκινο κύκλο — το
                         σύμβολο του ευρώ παίρνει κανονικά το Foreground και βγαίνει καθαρό λευκό. -->
                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Accent}"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="€" FontSize="24" FontWeight="ExtraBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Έμειναν ανεξόφλητα" FontSize="19" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBlock x:Name="UnsettledAmount" FontSize="30" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Μπήκαν στον τζίρο, αλλά δεν αντιστοιχούν σε καμία είσπραξη. Η αναφορά δεν έχει φύγει ακόμα."
                               FontSize="13" Foreground="{DynamicResource Neutral600}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>

                    <ScrollViewer MaxHeight="185" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="UnsettledList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface}" CornerRadius="12"
                                            Padding="14,11" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Where}" FontSize="13.5"
                                                       FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="12.5"
                                                       Margin="10,1,0,0" Foreground="{DynamicResource Neutral600}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AmountLabel}" FontSize="13.5"
                                                       FontWeight="ExtraBold" Foreground="{DynamicResource Accent700}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Content="← ΠΙΣΩ ΝΑ ΤΑ ΚΛΕΙΣΩ" Margin="0,16,0,0" Height="48" FontSize="15"
                            FontWeight="ExtraBold" Style="{StaticResource PrimaryButton}"
                            Click="BackToTables_Click"/>
                    <!-- Διακριτικό, όχι ισότιμο με το από πάνω: η σωστή κίνηση είναι να κλείσουν τα
                         τραπέζια — αυτό είναι η διέξοδος για όταν το ανεξόφλητο είναι πραγματικό
                         (κερασμένο τραπέζι, πελάτης που έφυγε), να μην πατιέται κατά λάθος. -->
                    <Button Content="ΣΤΕΙΛΕ ΤΗΝ ΕΤΣΙ" Margin="0,10,0,0" Padding="10,8" FontSize="13"
                            FontWeight="Bold" HorizontalAlignment="Center"
                            Style="{StaticResource FlatButton}" Click="SendAnyway_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ctl:ScaleHost>
</Window>
