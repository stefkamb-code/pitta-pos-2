<Window x:Class="PittaPos.App.Views.EmailSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PittaPos.App.Controls"
        Title="EMAIL ΑΝΑΦΟΡΑΣ" Height="640" Width="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <!-- Ολο το περιεχομενο μεγαλωνει/μικραινει μαζι με το παραθυρο (βλ. Controls/ScaleHost). -->
    <ctl:ScaleHost DesignWidth="624" DesignHeight="601">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png"
                       Height="32" Margin="0,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="EMAIL ΑΝΑΦΟΡΑΣ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Border/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,26" MaxWidth="520" HorizontalAlignment="Left">

                <TextBlock Text="ΠΟΥ ΘΑ ΕΡΧΕΤΑΙ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <TextBlock Text="Η αναλυτική αναφορά ημέρας φεύγει ΜΟΝΟ όταν πατήσεις «ΑΠΟΣΤΟΛΗ ΑΝΑΦΟΡΑΣ ΣΤΟ EMAIL» στις Ρυθμίσεις — ποτέ μόνη της. Αν δεν υπάρχει internet εκείνη τη στιγμή, ξαναδοκιμάζει μόνη της μέχρι να φύγει."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBox x:Name="ReportEmailBox" Style="{StaticResource PosTextBox}" Height="46" FontSize="14"
                         Width="380" HorizontalAlignment="Left" Margin="0,0,0,26"/>

                <TextBlock Text="ΑΠΟ ΠΟΙΟΝ ΛΟΓΑΡΙΑΣΜΟ ΘΑ ΦΕΥΓΕΙ" FontSize="11" FontWeight="ExtraBold"
                           Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                <TextBlock Text="Ένα Gmail του μαγαζιού. Θέλει «κωδικό εφαρμογής» της Google, όχι τον κανονικό κωδικό — η Google δεν αφήνει προγράμματα να συνδεθούν με αυτόν."
                           FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Gmail αποστολής" FontSize="12"
                           Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                <TextBox x:Name="SmtpUserBox" Style="{StaticResource PosTextBox}" Height="46" FontSize="14"
                         Width="380" HorizontalAlignment="Left" Margin="0,0,0,14"/>

                <TextBlock Text="Κωδικός εφαρμογής (16 χαρακτήρες)" FontSize="12"
                           Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                <TextBox x:Name="SmtpPasswordBox" Style="{StaticResource PosTextBox}" Height="46" FontSize="14"
                         Width="380" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                <!-- Τα βήματα γραμμένα εδώ, όχι σε χαρτάκι: χωρίς επαλήθευση δύο βημάτων η Google δεν
                     δείχνει καν την επιλογή, και εκεί κολλάει όποιος το επιχειρήσει πρώτη φορά. -->
                <TextBlock FontSize="11.5" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,0,0,20">
                    <Run Text="Πώς βγαίνει:" FontWeight="ExtraBold"/>
                    <Run Text=" Λογαριασμός Google → Ασφάλεια → πρέπει πρώτα να είναι ανοιχτή η επαλήθευση σε δύο βήματα → «Κωδικοί εφαρμογών». Δίνεις ένα όνομα (π.χ. «Ταμείο») και βγάζει 16 γράμματα — φαίνονται μία μόνο φορά. Τα κενά ανάμεσά τους δεν πειράζουν."/>
                </TextBlock>

                <Button Content="ΑΠΟΘΗΚΕΥΣΗ ΚΑΙ ΔΟΚΙΜΗ" Height="52" FontSize="14" FontWeight="ExtraBold" Width="260"
                        HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Center" Click="SaveEmail_Click"/>
                <TextBlock x:Name="EmailStatus" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource Neutral500}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
    </ctl:ScaleHost>
</Window>
