<Window x:Class="PittaPos.App.Views.CustomersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PittaPos.App.Controls"
        xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
        xmlns:models="clr-namespace:PittaPos.Core.Models;assembly=PittaPos.Core"
        Title="ΠΕΛΑΤΕΣ" Height="800" Width="1180"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Ολο το περιεχομενο μεγαλωνει/μικραινει μαζι με το παραθυρο, ΚΑΙ απλωνει στον χωρο που
         υπαρχει (βλ. Controls/ScaleHost) — γραμματα, κουμπια και αποστασεις στην ιδια αναλογια. -->
    <ctl:ScaleHost DesignWidth="1164" DesignHeight="761">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png"
                       Height="32" Margin="0,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="ΠΕΛΑΤΕΣ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Border/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- customer list -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <TextBox Style="{StaticResource PosTextBox}" Height="40" FontSize="14" Padding="30,4,8,4"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource Neutral500}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Αναζήτηση με τηλέφωνο, όνομα ή διεύθυνση" FontSize="13"
                                           Foreground="{DynamicResource Neutral500}" Margin="30,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Search}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Ταξινόμηση:" FontSize="12" Foreground="{DynamicResource Neutral600}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="Τζίρος" FontSize="12" FontWeight="ExtraBold" Padding="12,6" Margin="0,0,8,0"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding SetSortCommand}" CommandParameter="revenue">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SortByRevenue}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent700}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Συχνότητα" FontSize="12" FontWeight="ExtraBold" Padding="12,6"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding SetSortCommand}" CommandParameter="frequency">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SortByFrequency}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent700}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Δεν υπάρχουν πελάτες ακόμα" FontSize="12.5" Foreground="{DynamicResource Neutral500}"
                                       HorizontalAlignment="Center" Margin="0,24"
                                       Visibility="{Binding NoCustomers, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding Customers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CustomerRowViewModel}">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Padding="16,12" BorderThickness="0,0,0,1"
                                                Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{x:Static vm:SameObjectConverter.Instance}">
                                                                    <Binding Path="Customer"/>
                                                                    <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RevenueLabel}" FontSize="13"
                                                               FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="ExtraBold"
                                                               Foreground="{DynamicResource Ink}"/>
                                                </DockPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding OrdersLabel}" FontSize="11.5"
                                                               FontWeight="ExtraBold" Foreground="{DynamicResource Accent700}"/>
                                                    <TextBlock Text="{Binding Phone}" FontSize="11.5" Foreground="{DynamicResource Neutral600}"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- customer detail -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="30,26">
                    <TextBlock Text="Επίλεξε πελάτη από τη λίστα" FontSize="13" Foreground="{DynamicResource Neutral500}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                               Visibility="{Binding NothingSelected, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SelectedName}" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="{Binding SelectedContact}" FontSize="13" Foreground="{DynamicResource Neutral600}"
                                   Margin="0,2,0,4" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding NotesLabel}" FontSize="12.5" FontStyle="Italic"
                                   Foreground="{DynamicResource Neutral600}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>

                        <!-- πρόσθετες διευθύνσεις -->
                        <StackPanel Visibility="{Binding HasOtherAddresses, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                            <TextBlock Text="ΑΛΛΕΣ ΔΙΕΥΘΥΝΣΕΙΣ" FontSize="11" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource Neutral600}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding OtherAddresses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CustomerAddress}">
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GlyphButton}"
                                                        FontSize="15" Foreground="{DynamicResource Accent}" Width="26"
                                                        ToolTip="Διαγραφή διεύθυνσης (π.χ. μετακόμισε)"
                                                        Command="{Binding DataContext.DeleteOtherAddressCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <StackPanel>
                                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextWrapping="Wrap">
                                                        <Run Text="{Binding Address, Mode=OneWay}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding StreetNumber, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Area}" FontSize="11" Foreground="{DynamicResource Neutral500}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- memo / reminder -->
                        <TextBlock Text="ΥΠΕΝΘΥΜΙΣΗ (εμφανίζεται όταν παραγγέλνει)" FontSize="11" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Neutral600}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource PosTextBox}" Height="56" FontSize="13.5"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8,6"
                                 Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,24">
                            <Button Content="ΑΠΟΘΗΚΕΥΣΗ ΥΠΕΝΘΥΜΙΣΗΣ" Height="40" FontSize="12.5" FontWeight="ExtraBold"
                                    Padding="14,0" Style="{StaticResource FlatButton}"
                                    HorizontalContentAlignment="Center" Command="{Binding SaveMemoCommand}"/>
                            <TextBlock Text="✓ Αποθηκεύτηκε" FontSize="12.5" FontWeight="ExtraBold"
                                       Foreground="#2e7d32" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding MemoSaved, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- summary tiles -->
                        <UniformGrid Columns="4" Margin="0,0,0,26">
                            <Grid Margin="0,0,12,0">
                                <Border Background="{DynamicResource Bg}" CornerRadius="12" Effect="{StaticResource SoftShadowSmall}"/>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="ΠΑΡΑΓΓΕΛΙΕΣ" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"/>
                                        <TextBlock Text="{Binding OrderCountLabel}" FontSize="24" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Ink}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,12,0">
                                <Border Background="{DynamicResource Bg}" CornerRadius="12" Effect="{StaticResource SoftShadowSmall}"/>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="ΤΖΙΡΟΣ" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"/>
                                        <TextBlock Text="{Binding RevenueLabel}" FontSize="24" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Accent700}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,12,0">
                                <Border Background="{DynamicResource Bg}" CornerRadius="12" Effect="{StaticResource SoftShadowSmall}"/>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="ΣΥΧΝΟΤΗΤΑ" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"/>
                                        <TextBlock Text="{Binding FrequencyLabel}" FontSize="16" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <Border Background="{DynamicResource Bg}" CornerRadius="12" Effect="{StaticResource SoftShadowSmall}"/>
                                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <TextBlock Text="ΤΕΛΕΥΤΑΙΑ" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"/>
                                        <TextBlock Text="{Binding LastOrderLabel}" FontSize="16" FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource Ink}" Margin="0,7,0,0"/>
                                        <TextBlock Text="{Binding FirstOrderLabel}" FontSize="10.5" Foreground="{DynamicResource Neutral500}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </UniformGrid>

                        <!-- favorite products -->
                        <TextBlock Text="ΑΓΑΠΗΜΕΝΑ ΠΡΟΪΟΝΤΑ" FontSize="11" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="12">
                            <ItemsControl ItemsSource="{Binding Favorites}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FavoriteProductViewModel}">
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="16,10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" FontSize="14"
                                                           FontWeight="ExtraBold" Foreground="{DynamicResource Accent700}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RankLabel}" FontSize="12.5" FontWeight="ExtraBold"
                                                               Foreground="{DynamicResource Neutral500}" Width="28"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Ink}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
    </ctl:ScaleHost>
</Window>
