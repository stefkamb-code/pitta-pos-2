<Window x:Class="PittaPos.App.Views.MenuManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:PittaPos.App.Controls"
        xmlns:vm="clr-namespace:PittaPos.App.ViewModels"
        xmlns:ac="clr-namespace:PittaPos.App.Controls"
        xmlns:models="clr-namespace:PittaPos.Core.Models;assembly=PittaPos.Core"
        Title="ΔΙΑΧΕΙΡΙΣΗ ΚΑΤΑΛΟΓΟΥ" Height="800" Width="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Ολο το περιεχομενο μεγαλωνει/μικραινει μαζι με το παραθυρο, ΚΑΙ απλωνει στον χωρο που
         υπαρχει (βλ. Controls/ScaleHost) — γραμματα, κουμπια και αποστασεις στην ιδια αναλογια. -->
    <ctl:ScaleHost DesignWidth="1264" DesignHeight="761">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png"
                       Height="32" Margin="0,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="ΔΙΑΧΕΙΡΙΣΗ ΚΑΤΑΛΟΓΟΥ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="⤓ EXPORT EXCEL" FontSize="11.5" FontWeight="ExtraBold"
                        Style="{StaticResource FlatButton}" Padding="12,6"
                        VerticalAlignment="Center" Click="ExportExcel_Click"/>
                <Button DockPanel.Dock="Right" Content="ΕΞΤΡΑ" FontSize="11.5" FontWeight="ExtraBold"
                        Style="{StaticResource FlatButton}" Padding="12,6" Margin="0,0,10,0"
                        VerticalAlignment="Center" Click="ManageExtras_Click"/>
                <Border/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Αναλογικές στήλες (24/30/46 — όσο πιάνουν σε οθόνη 1280) αντί για σταθερές 300/380:
                 όταν μεγαλώνει το παράθυρο μοιράζονται τον επιπλέον χώρο και οι τρεις. Πριν, μόνο η
                 φόρμα δεξιά φάρδαινε και οι λίστες έμεναν στενές όσο μεγάλη κι αν ήταν η οθόνη.
                 Τα MinWidth κρατούν τις λίστες χρησιμοποιήσιμες σε μικρό παράθυρο. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24*" MinWidth="250"/>
                <ColumnDefinition Width="30*" MinWidth="300"/>
                <ColumnDefinition Width="46*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- categories -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,14">
                        <TextBlock Text="Κατηγορίες" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MenuCategory}">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="16,12" BorderThickness="0,0,0,1"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{x:Static vm:SameObjectConverter.Instance}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Products.Count}" FontSize="11.5"
                                                       Foreground="{DynamicResource Neutral500}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource Ink}"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,2,0,0" Padding="12">
                        <Button Content="+ ΝΕΑ ΚΑΤΗΓΟΡΙΑ" Style="{StaticResource FlatButton}" Height="42"
                                FontSize="12.5" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                                Command="{Binding AddCategoryCommand}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- products of category -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,14">
                        <TextBlock Text="Προϊόντα" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Product}">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="16,10" BorderThickness="0,0,0,1"
                                            AllowDrop="True"
                                            Drop="ProductItem_Drop"
                                            Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{x:Static vm:SameObjectConverter.Instance}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.SelectedProduct" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{DynamicResource Accent100}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Price, StringFormat=€{0:0.00}}"
                                                       FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource Ink}"/>
                                            <Border DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,6,0"
                                                    Background="Transparent" Cursor="SizeAll" ToolTip="Σύρε για αλλαγή σειράς"
                                                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                                                <TextBlock Text="⠿" FontSize="15" Foreground="{DynamicResource Neutral400}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,2,0,0" Padding="12"
                            Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                        <Button Content="+ ΝΕΟ ΠΡΟΪΟΝ" Style="{StaticResource FlatButton}" Height="42"
                                FontSize="12.5" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                                Command="{Binding NewProductCommand}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- editor -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26" MaxWidth="460" HorizontalAlignment="Left">

                    <!-- category editor: ορατός και για νέα κατηγορία (πριν δημιουργηθεί) -->
                    <StackPanel Visibility="{Binding ShowCategoryEditor, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CategoryFormTitle}" FontSize="11" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                    <!-- Ίδια θέση, δύο ρόλοι ανάλογα με το τι δουλεύεις:
                         χωρίς επιλεγμένο προϊόν -> μετονομασία της κατηγορίας
                         μέσα σε προϊόν          -> σε ποια κατηγορία ανήκει το προϊόν
                         Έτσι δεν συνυπάρχουν δύο πεδία «κατηγορία» που μπερδεύουν, και δεν πιάνει
                         χώρο η μετονομασία τη στιγμή που δεν έχει καμία δουλειά. -->
                    <StackPanel Visibility="{Binding ShowCategoryRename, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Όνομα κατηγορίας (μετονομασία)" FontSize="11"
                                   Foreground="{DynamicResource Neutral500}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource PosTextBox}" Height="42" FontSize="14"
                                 ac:AutoComplete.Suggestions="{Binding CategoryNameSuggestions}"
                                 Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsEditingProduct, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Κατηγορία του προϊόντος" FontSize="11"
                                   Foreground="{DynamicResource Neutral500}" Margin="0,0,0,4"/>
                        <!-- Ίδιος λόγος με τη λίστα εκτυπωτών: χωρίς το δικό μας style, το dropdown
                             βγαίνει λευκό και στο μαύρο θέμα οι κατηγορίες γίνονται αδιάβαστες. -->
                        <ComboBox Style="{StaticResource PosComboBox}"
                                  ItemsSource="{Binding Categories}" SelectedItem="{Binding ProductCategory}"
                                  DisplayMemberPath="Name" Height="42" FontSize="14"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <!-- Όλη η γραμμή της κατηγορίας (μετονομασία / ▲▼ / κάδος) φεύγει όσο δουλεύεις
                         προϊόν: εκεί δεν επεξεργάζεσαι κατηγορία και έπιανε τζάμπα χώρο. Κρύβεται το
                         ίδιο το Grid, όχι μόνο τα κουμπιά, αλλιώς έμενε το κενό του περιθωρίου. -->
                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding ShowCategoryRename, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding CategorySaveLabel}" Style="{StaticResource FlatButton}" Height="40"
                                Visibility="{Binding ShowCategoryRename, Converter={StaticResource BoolToVis}}"
                                FontSize="12" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                                Command="{Binding SaveCategoryCommand}"/>
                        <Button Grid.Column="2" Content="▲" Style="{StaticResource FlatButton}" Width="40" Height="40"
                                HorizontalContentAlignment="Center" ToolTip="Μετακίνηση πάνω"
                                Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}"
                                Command="{Binding MoveCategoryUpCommand}"/>
                        <Button Grid.Column="4" Content="▼" Style="{StaticResource FlatButton}" Width="40" Height="40"
                                HorizontalContentAlignment="Center" ToolTip="Μετακίνηση κάτω"
                                Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}"
                                Command="{Binding MoveCategoryDownCommand}"/>
                        <Button Grid.Column="6" Content="🗑" Style="{StaticResource FlatButton}" Width="40" Height="40"
                                HorizontalContentAlignment="Center" ToolTip="Διαγραφή κατηγορίας"
                                Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}"
                                Foreground="{DynamicResource Accent}" Command="{Binding DeleteCategoryCommand}"/>
                    </Grid>

                    <!-- Συμπεριφορά κατηγορίας — αποθηκεύεται ΜΕΣΑ στην κατηγορία, όχι με βάση το όνομά
                         της. Παλιότερα ήταν γραμμένο στον κώδικα (π.χ. «αν λέγεται ΤΥΛΙΧΤΑ»), οπότε μια
                         μετονομασία σταματούσε σιωπηλά το ψωμί και τη διπλή πίτα σε όλη την κατηγορία και
                         χρειαζόταν νέα εγκατάσταση για να διορθωθεί. Τώρα ρυθμίζεται εδώ. -->
                    <StackPanel Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}"
                                Margin="0,18,0,0">
                        <TextBlock Text="ΣΥΜΠΕΡΙΦΟΡΑ ΚΑΤΗΓΟΡΙΑΣ" FontSize="11" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>
                        <CheckBox Content="Ρωτάει ψωμί (Ελληνική / Αραβική)" FontSize="13"
                                  Foreground="{DynamicResource Ink}" Margin="0,0,0,8"
                                  IsChecked="{Binding CategoryHasBread}"/>
                        <CheckBox Content="Το ψωμί μπαίνει μέσα στο όνομα (π.χ. «ΑΡ. Κοτόπουλο»)" FontSize="13"
                                  Foreground="{DynamicResource Ink}" Margin="18,0,0,8"
                                  IsEnabled="{Binding CategoryFuseBreadEnabled}"
                                  IsChecked="{Binding CategoryFuseBread}"/>
                        <!-- Χωρίς IsEnabled: η διπλή πίτα δεν εξαρτάται από το ψωμί (τα ΚΛΑΣΙΚΑ ΜΙΚΡΑ
                             την έχουν χωρίς καμία επιλογή ψωμιού) — βλ. CategoryFuseBreadEnabled. -->
                        <CheckBox Content="Έχει επιλογή «διπλή πίτα»" FontSize="13"
                                  Foreground="{DynamicResource Ink}"
                                  IsChecked="{Binding CategoryDoublePita}"/>
                        <!-- Ποια από τις δύο χρεώσεις παίρνει η κατηγορία. Δύο τιμές μόνο, οπότε ένα
                             κουμπί που τις εναλλάσσει — όχι λίστα επιλογών. -->
                        <StackPanel Margin="18,6,0,0"
                                    Visibility="{Binding CategoryDoublePita, Converter={StaticResource BoolToVis}}">
                            <Button Content="{Binding CategoryPitaSizeLabel}" FontSize="11" FontWeight="ExtraBold"
                                    Padding="12,6" HorizontalAlignment="Left" Style="{StaticResource FlatButton}"
                                    ToolTip="Πάτησέ το για να αλλάξεις μικρή ↔ μεγάλη"
                                    Command="{Binding ToggleCategoryPitaSizeCommand}"/>
                            <TextBlock Text="Η χρέωση της διπλής πίτας μπαίνει μία φορά ανά μέγεθος, παρακάτω στον κατάλογο έξτρα."
                                       FontSize="11" Foreground="{DynamicResource Neutral600}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Αν η κατηγορία στέλνεται στο e-food μαζί με τον κατάλογο (Ρυθμίσεις → E-FOOD).
                             Σβηστό σε ό,τι δεν είναι για πελάτες, π.χ. ΠΡΟΣΩΠΙΚΟ. -->
                        <CheckBox Content="Εμφανίζεται στο e-food" FontSize="13"
                                  Foreground="{DynamicResource Ink}" Margin="0,14,0,0"
                                  IsChecked="{Binding CategoryOnEfood}"/>

                        <!-- ΦΠΑ της κατηγορίας: από εδώ βγαίνει το «ΜΕ 13% / ΜΕ 24%» κάτω από το ΣΥΝΟΛΟ
                             της απόδειξης. Ρητά αποθηκευμένο, ΟΧΙ βάσει ονόματος — μια μετονομασία δεν
                             πρέπει να αλλάξει σιωπηλά τον φόρο. -->
                        <Button Content="{Binding CategoryVatLabel}" FontSize="11.5" FontWeight="ExtraBold"
                                Padding="12,7" Margin="0,16,0,4" HorizontalAlignment="Left"
                                Style="{StaticResource FlatButton}"
                                Command="{Binding ToggleVatOptionsCommand}"/>
                        <ItemsControl ItemsSource="{Binding VatOptions}"
                                      Visibility="{Binding ShowVatOptions, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" FontSize="12" FontWeight="ExtraBold"
                                            Padding="12,8" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SetCategoryVatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Kind}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>

                    <!-- product editor: μόνο για υπάρχουσα κατηγορία -->
                    <StackPanel Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,2,0,0" Margin="0,26,0,26"/>

                    <TextBlock Text="{Binding ProductFormTitle}" FontSize="11" FontWeight="ExtraBold"
                               Foreground="{DynamicResource Neutral600}" Margin="0,0,0,8"/>


                    <!-- Τα πεδία με προτάσεις (ac:AutoComplete.Suggestions) δείχνουν καθώς γράφεις ό,τι
                         υπάρχει ήδη στον κατάλογο — έτσι το ίδιο προϊόν/υλικό δεν γράφεται δεύτερη φορά
                         με άλλη ορθογραφία. Το κάτω βελάκι σε άδειο πεδίο τα δείχνει όλα. -->
                    <TextBlock Text="Όνομα στο μενού" FontSize="12" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource PosTextBox}" Height="40" FontSize="13.5" Margin="0,0,0,12"
                             ac:AutoComplete.Suggestions="{Binding ProductNameSuggestions}"
                             Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Όνομα στην εκτύπωση" FontSize="12" Foreground="{DynamicResource Neutral700}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource PosTextBox}" Height="40" FontSize="13.5" Margin="0,0,0,4"
                             ac:AutoComplete.Suggestions="{Binding ProductPrintNameSuggestions}"
                             Text="{Binding ProductPrintName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Άφησέ το κενό για να τυπώνεται ό,τι λέει και το μενού" FontSize="11"
                               Foreground="{DynamicResource Neutral500}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Κανονική τιμή (€)" FontSize="12" Foreground="{DynamicResource Neutral700}"/>
                        <TextBlock Grid.Column="2" Text="Τιμή εφαρμογών e-food/Wolt/BOX (€)" FontSize="12" Foreground="{DynamicResource Neutral700}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource PosTextBox}" Height="40" FontSize="13.5"
                                 Text="{Binding ProductPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="2" Style="{StaticResource PosTextBox}" Height="40" FontSize="13.5"
                                 Text="{Binding ProductDeliveryPrice, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <TextBlock Text="Κενή τιμή εφαρμογών = ισχύει παντού η κανονική τιμή" FontSize="11"
                               Foreground="{DynamicResource Neutral500}" Margin="0,0,0,12"/>

                    <!-- Τα ΒΑΣΙΚΑ υλικά φαίνονται ΠΑΝΤΑ, ασχέτως αν το προϊόν ανοίγει έξτρα: μπορεί να
                         θέλεις να γράψεις τι έχει μέσα ένα προϊόν που δεν παίρνει καθόλου έξτρα. Πριν
                         ήταν κλεισμένα μαζί με τα έξτρα στο ίδιο κρυφό πάνελ.
                         Μέχρι πρόσφατα ήταν και σταθερή λίστα για όλα τα προϊόντα, γραμμένη στον
                         κώδικα — η ομελέτα έδειχνε «χωρίς κρεμμύδι» ακόμα κι αν δεν είχε. -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Βασικά υλικά που έχει μέσα το προϊόν" FontSize="12"
                                   Foreground="{DynamicResource Neutral700}" Margin="0,0,0,2"/>
                        <TextBlock Text="Ξεχωριστά για κάθε προϊόν — δεν αλλάζουν τα υπόλοιπα" FontSize="11"
                                   Foreground="{DynamicResource Neutral500}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding IngredientToggles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Χωρίς κουτάκι επιλογής: ό,τι φαίνεται εδώ ΕΙΝΑΙ τα υλικά του
                                         προϊόντος. Το × το βγάζει, το «+ ΥΛΙΚΟ» το προσθέτει.
                                         Η λαβή «⠿» αλλάζει τη σειρά ΜΟΝΟ σε αυτό το προϊόν. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,8" Background="Transparent"
                                                AllowDrop="True" Drop="IngredientChip_Drop">
                                        <TextBlock Text="⠿" FontSize="12" Margin="0,0,5,0" Cursor="SizeAll"
                                                   VerticalAlignment="Center" ToolTip="Σύρε για αλλαγή σειράς"
                                                   Foreground="{DynamicResource Neutral500}"
                                                   MouseLeftButtonDown="IngredientHandle_MouseLeftButtonDown"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Ink}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="×" Style="{StaticResource GlyphButton}" FontSize="12" Width="20" Height="20"
                                                Margin="4,0,0,0" ToolTip="Αφαίρεση από ΑΥΤΟ το προϊόν"
                                                Foreground="{DynamicResource Neutral500}"
                                                Command="{Binding DataContext.RemoveIngredientCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,4,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PosTextBox}" Height="36" FontSize="12.5"
                                     ac:AutoComplete.Suggestions="{Binding IngredientSuggestions}"
                                     Text="{Binding NewIngredientName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="+ ΥΛΙΚΟ" Style="{StaticResource FlatButton}"
                                    Height="36" FontSize="10.5" FontWeight="ExtraBold" Padding="12,0"
                                    Command="{Binding AddIngredientCommand}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Ο διακόπτης κάθεται ΠΑΝΩ από αυτό που ελέγχει: πριν ήταν ψηλά, πάνω κι από τα
                         βασικά υλικά, και έμοιαζε να τα αφορά κι εκείνα. -->
                    <CheckBox Content="Ανοίγει τα έξτρα" FontSize="12.5"
                              Foreground="{DynamicResource Ink}" Margin="0,0,0,12"
                              IsChecked="{Binding ProductCustomizable}"/>

                    <StackPanel Visibility="{Binding ProductCustomizable, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,18">
                        <TextBlock Text="Έξτρα που επιτρέπονται σε αυτό το προϊόν" FontSize="12"
                                   Foreground="{DynamicResource Neutral700}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ExtraToggles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Η λαβή «⠿» αλλάζει τη σειρά των έξτρα ΜΟΝΟ σε αυτό το προϊόν —
                                         ο κοινός κατάλογος από κάτω έχει τη δική του, ανεξάρτητη σειρά. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" Background="Transparent"
                                                AllowDrop="True" Drop="ExtraChip_Drop">
                                        <TextBlock Text="⠿" FontSize="12" Margin="0,0,5,0" Cursor="SizeAll"
                                                   VerticalAlignment="Center" ToolTip="Σύρε για αλλαγή σειράς"
                                                   Foreground="{DynamicResource Neutral500}"
                                                   MouseLeftButtonDown="ExtraHandle_MouseLeftButtonDown"/>
                                        <CheckBox Content="{Binding Name}" FontSize="12" Foreground="{DynamicResource Ink}"
                                                  IsChecked="{Binding IsChecked}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Χωρίς καμία επιλογή δεν βγαίνει νόημα — άφησέ τα όλα τσεκαρισμένα αν δεν χρειάζεται περιορισμός."
                                   FontSize="11" Foreground="{DynamicResource Neutral500}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="ΑΠΟΘΗΚΕΥΣΗ ΠΡΟΪΟΝΤΟΣ" Style="{StaticResource PrimaryButton}"
                                Height="46" FontSize="13.5" HorizontalContentAlignment="Center"
                                Command="{Binding SaveProductCommand}"/>
                        <Button Grid.Column="2" Content="ΔΙΑΓΡΑΦΗ" Style="{StaticResource FlatButton}"
                                Height="46" FontSize="13" FontWeight="ExtraBold" HorizontalContentAlignment="Center"
                                Foreground="{DynamicResource Accent}"
                                Visibility="{Binding IsEditingProduct, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DeleteProductCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="ExtraBold"
                               Foreground="#2e7d32" Margin="0,12,0,0"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </ctl:ScaleHost>
</Window>
