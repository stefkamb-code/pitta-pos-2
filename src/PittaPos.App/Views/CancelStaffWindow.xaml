<Window x:Class="PittaPos.App.Views.CancelStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ΚΩΔΙΚΟΙ ΑΚΥΡΩΣΗΣ" Height="600" Width="560"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="{StaticResource PosFont}"
        Background="{DynamicResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,2" Padding="18,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" FontSize="16" Style="{StaticResource GlyphButton}"
                        Margin="0,0,12,0" Click="Back_Click"/>
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png"
                       Height="32" Margin="0,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="ΚΩΔΙΚΟΙ ΑΚΥΡΩΣΗΣ" FontWeight="ExtraBold" FontSize="14"
                           Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
                <Border/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,26" MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock Text="Κάθε μέλος του προσωπικού παίρνει το δικό του 4ψήφιο κωδικό ακύρωσης. Όταν κάποιος ακυρώνει παραγγελία ή προϊόν, βάζει τον δικό του κωδικό — έτσι το ιστορικό ακυρωμένων δείχνει ποιος το έκανε. Άδεια θέση = ανενεργή."
                           FontSize="12.5" Foreground="{DynamicResource Neutral600}" TextWrapping="Wrap" Margin="0,0,0,24"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ΟΝΟΜΑ" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"/>
                    <TextBlock Grid.Column="2" Text="ΚΩΔΙΚΟΣ" FontSize="11" FontWeight="ExtraBold" Foreground="{DynamicResource Neutral600}"/>
                </Grid>

                <ItemsControl x:Name="RowsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource PosTextBox}" Height="42"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Style="{StaticResource PosTextBox}" Height="42"
                                         MaxLength="4" HorizontalContentAlignment="Center" FontWeight="Bold"
                                         Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="ErrorText" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                           TextWrapping="Wrap" Margin="0,4,0,14" Visibility="Collapsed"/>

                <Button Content="ΑΠΟΘΗΚΕΥΣΗ" Height="48" FontSize="14" FontWeight="ExtraBold" Width="250"
                        HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                        HorizontalContentAlignment="Center" Click="Save_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
